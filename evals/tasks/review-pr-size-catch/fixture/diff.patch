+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Command;
+
+use Shopware\Core\Framework\Context;
+use Swag\LowStockDigest\Event\LowStockDigestPrintedEvent;
+use Swag\LowStockDigest\Service\LowStockDigestBuilder;
+use Swag\LowStockDigest\Service\LowStockDigestFormatter;
+use Symfony\Component\Console\Attribute\AsCommand;
+use Symfony\Component\Console\Command\Command;
+use Symfony\Component\Console\Input\InputInterface;
+use Symfony\Component\Console\Input\InputOption;
+use Symfony\Component\Console\Output\OutputInterface;
+use Symfony\Component\Console\Style\SymfonyStyle;
+use Symfony\Component\EventDispatcher\EventDispatcherInterface;
+
+#[AsCommand(
+    name: 'swag:low-stock:digest',
+    description: 'Lists the products at or below the low-stock threshold',
+)]
+class LowStockDigestCommand extends Command
+{
+    public function __construct(
+        private readonly LowStockDigestBuilder $builder,
+        private readonly LowStockDigestFormatter $formatter,
+        private readonly EventDispatcherInterface $dispatcher,
+    ) {
+        parent::__construct();
+    }
+
+    protected function configure(): void
+    {
+        $this->addOption('sales-channel', 's', InputOption::VALUE_REQUIRED, 'Sales channel whose threshold applies');
+        $this->addOption('json', null, InputOption::VALUE_NONE, 'Print JSON instead of a table');
+        $this->addOption('csv', null, InputOption::VALUE_NONE, 'Print semicolon separated rows');
+    }
+
+    protected function execute(InputInterface $input, OutputInterface $output): int
+    {
+        $io = new SymfonyStyle($input, $output);
+        $salesChannelId = $input->getOption('sales-channel');
+        $context = Context::createCLIContext();
+        $rows = $this->builder->build(
+            $context,
+            is_string($salesChannelId) ? $salesChannelId : null,
+        );
+
+        $this->dispatcher->dispatch(new LowStockDigestPrintedEvent(
+            array_column($rows, 'id'),
+            $context,
+        ));
+
+        if ($input->getOption('json')) {
+            $output->writeln(json_encode($rows, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT));
+
+            return self::SUCCESS;
+        }
+
+        if ($input->getOption('csv')) {
+            $output->write($this->formatter->toCsv($rows));
+
+            return self::SUCCESS;
+        }
+
+        if ($rows === []) {
+            $io->success('No product is at or below the threshold.');
+
+            return self::SUCCESS;
+        }
+
+        $io->table(['Number', 'Name', 'Stock'], $this->formatter->toTableRows($rows));
+        $io->warning(sprintf('%d product(s) need a restock.', count($rows)));
+
+        return self::SUCCESS;
+    }
+}
