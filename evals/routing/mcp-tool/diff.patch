diff --git a/src/Mcp/Tool/PointsSummaryTool.php b/src/Mcp/Tool/PointsSummaryTool.php
new file mode 100644
--- /dev/null
+++ b/src/Mcp/Tool/PointsSummaryTool.php
@@ -0,0 +1,33 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Mcp\Tool;
+
+use Mcp\Capability\Attribute\McpTool;
+use Mcp\Schema\ToolAnnotations;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolGroup;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolRequires;
+use Shopware\Core\Framework\Mcp\Context\McpContextProvider;
+use Shopware\Core\Framework\Mcp\Result\McpToolResult;
+use Shopware\Core\Framework\Mcp\Tool\McpToolResponse;
+
+#[McpTool(
+    name: 'swag-loyalty-points-summary',
+    annotations: new ToolAnnotations(readOnlyHint: true, openWorldHint: false),
+    description: 'Return total active loyalty points.',
+)]
+#[McpToolGroup('swag-loyalty', description: 'Loyalty point reporting tools.')]
+#[McpToolRequires('swag_loyalty_points:read')]
+class PointsSummaryTool extends McpToolResponse
+{
+    public function __construct(
+        private readonly McpContextProvider $contextProvider,
+    ) {
+    }
+
+    public function __invoke(): McpToolResult
+    {
+        $context = $this->contextProvider->getContext();
+        return $this->requirePrivilegeResult($context, 'swag_loyalty_points:read')
+            ?? $this->successResult(['total' => 0]);
+    }
+}
