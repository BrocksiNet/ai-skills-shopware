+<?php declare(strict_types=1);
+
+namespace Swag\LoyaltyPoints\Command;
+
+use Shopware\Core\Checkout\Order\OrderEntity;
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Filter\EqualsFilter;
+use Symfony\Component\Console\Attribute\AsCommand;
+use Symfony\Component\Console\Command\Command;
+use Symfony\Component\Console\Input\InputInterface;
+use Symfony\Component\Console\Output\OutputInterface;
+
+#[AsCommand(name: 'swag:loyalty:backfill', description: 'Writes loyalty points to orders placed before the plugin was installed')]
+class BackfillLoyaltyPointsCommand extends Command
+{
+    public function __construct(private readonly EntityRepository $orderRepository)
+    {
+        parent::__construct();
+    }
+
+    protected function execute(InputInterface $input, OutputInterface $output): int
+    {
+        $context = Context::createDefaultContext();
+        $criteria = (new Criteria())->setLimit(200);
+        $criteria->addFilter(new EqualsFilter('customFields.swag_loyalty_points', null));
+        $criteria->addAssociation('lineItems');
+
+        $updated = 0;
+        do {
+            $orders = $this->orderRepository->search($criteria, $context)->getEntities();
+            $payload = [];
+            foreach ($orders as $order) {
+                $payload[] = [
+                    'id' => $order->getId(),
+                    'customFields' => ['swag_loyalty_points' => $this->pointsFor($order)],
+                ];
+            }
+            if ($payload !== []) {
+                $this->orderRepository->update($payload, $context);
+                $updated += \count($payload);
+            }
+        } while ($payload !== []);
+
+        $output->writeln(sprintf('Updated %d orders.', $updated));
+
+        return Command::SUCCESS;
+    }
+
+    private function pointsFor(OrderEntity $order): int
+    {
+        $points = 0;
+        foreach ($order->getLineItems()?->getElements() ?? [] as $item) {
+            $points += (int) floor($item->getTotalPrice());
+        }
+
+        return $points;
+    }
+}
