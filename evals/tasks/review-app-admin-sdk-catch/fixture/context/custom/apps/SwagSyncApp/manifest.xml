<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>SwagSyncApp</name>
        <label>Sync App</label>
        <description>Connects orders to an external fulfillment service.</description>
        <author>Swag</author>
        <copyright>(c) Swag</copyright>
        <version>1.0.0</version>
        <license>MIT</license>
    </meta>
    <setup>
        <registrationUrl>https://sync.example.com/register</registrationUrl>
    </setup>
    <requirements>
        <public-access/>
    </requirements>
    <permissions>
        <read>order</read>
    </permissions>
</manifest>
