diff --git a/src/StoreApi/LoyaltyHistoryRoute.php b/src/StoreApi/LoyaltyHistoryRoute.php
new file mode 100644
--- /dev/null
+++ b/src/StoreApi/LoyaltyHistoryRoute.php
@@ -0,0 +1,34 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\StoreApi;
+
+use Shopware\Core\Checkout\Customer\CustomerEntity;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+use Shopware\Core\System\SalesChannel\StoreApiResponse;
+use Swag\Loyalty\Points\PointsCalculator;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['store-api']])]
+#[Package('checkout')]
+class LoyaltyHistoryRoute
+{
+    public function __construct(private readonly PointsCalculator $points)
+    {
+    }
+
+    #[Route(
+        path: '/store-api/loyalty/history',
+        name: 'store-api.loyalty.history',
+        defaults: ['_loginRequired' => true],
+        methods: ['POST'],
+    )]
+    public function load(Request $request, SalesChannelContext $context, CustomerEntity $customer): StoreApiResponse
+    {
+        $limit = $request->request->getInt('limit', 20);
+        $entries = $this->points->history($customer->getId(), $context->getContext(), $limit);
+
+        return new StoreApiResponse(new LoyaltyHistoryStruct($entries));
+    }
+}
diff --git a/src/StoreApi/LoyaltyHistoryStruct.php b/src/StoreApi/LoyaltyHistoryStruct.php
