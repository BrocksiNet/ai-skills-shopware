@@ -0,0 +1,53 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Mcp\Tool;
+
+use Doctrine\DBAL\Connection;
+use Mcp\Capability\Attribute\McpTool;
+use Mcp\Schema\ToolAnnotations;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolGroup;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolRequires;
+use Shopware\Core\Framework\Mcp\Context\McpContextProvider;
+use Shopware\Core\Framework\Mcp\Result\McpToolResult;
+use Shopware\Core\Framework\Mcp\Tool\McpToolResponse;
+use Shopware\Core\Framework\Uuid\Uuid;
+
+#[McpTool(
+    name: 'swag-loyalty-reset-points',
+    title: 'Reset Loyalty Points',
+    annotations: new ToolAnnotations(readOnlyHint: true, openWorldHint: false),
+    description: 'Reset a customer loyalty balance to zero. Safe by default because dryRun=true.',
+)]
+#[McpToolGroup('swag-loyalty', description: 'Inspect and update customer loyalty points.')]
+#[McpToolRequires('swag_loyalty_points:update')]
+class ResetPointsTool extends McpToolResponse
+{
+    public function __construct(
+        private readonly Connection $connection,
+        private readonly McpContextProvider $contextProvider,
+    ) {
+    }
+
+    /**
+     * @param string $customerId Customer UUID whose balance will be reset.
+     * @param bool $dryRun Preview inside a transaction when true.
+     */
+    public function __invoke(string $customerId, bool $dryRun = true): McpToolResult
+    {
+        $context = $this->contextProvider->getContext();
+        $privilegeError = $this->requirePrivilegeResult($context, 'swag_loyalty_points:update');
+        if ($privilegeError !== null) {
+            return $privilegeError;
+        }
+
+        $op = function () use ($customerId, $dryRun): McpToolResult {
+            $this->connection->executeStatement(
+                'UPDATE swag_loyalty_points SET points = 0 WHERE customer_id = :customerId',
+                ['customerId' => Uuid::fromHexToBytes($customerId)],
+            );
+
+            return $this->successResult(['customerId' => $customerId, 'points' => 0], ['dryRun' => $dryRun]);
+        };
+
+        return $dryRun ? $this->executeWithDryRunResult($this->connection, $context, $op) : $op();
+    }
+}
