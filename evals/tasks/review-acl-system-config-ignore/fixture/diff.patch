+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Controller;
+
+use Shopware\Core\Framework\Uuid\Uuid;
+use Shopware\Core\System\SystemConfig\SystemConfigService;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['api']])]
+final class LoyaltySettingsController
+{
+    private const DOMAIN = 'SwagLoyalty.config.';
+
+    public function __construct(private readonly SystemConfigService $systemConfigService)
+    {
+    }
+
+    #[Route(path: '/api/_action/swag-loyalty/settings', name: 'api.action.swag_loyalty.settings.load', defaults: ['_acl' => ['swag_loyalty.viewer']], methods: ['GET'])]
+    public function load(): JsonResponse
+    {
+        return new JsonResponse([
+            'pointsPerEuro' => $this->systemConfigService->getInt(self::DOMAIN . 'pointsPerEuro'),
+            'expiryDays' => $this->systemConfigService->getInt(self::DOMAIN . 'expiryDays'),
+            'defaultTierId' => $this->systemConfigService->getString(self::DOMAIN . 'defaultTierId') ?: null,
+        ]);
+    }
+
+    #[Route(path: '/api/_action/swag-loyalty/settings', name: 'api.action.swag_loyalty.settings.save', defaults: ['_acl' => ['swag_loyalty.editor']], methods: ['POST'])]
+    public function save(Request $request): Response
+    {
+        $tierId = $request->request->getString('defaultTierId');
+
+        $this->systemConfigService->set(self::DOMAIN . 'pointsPerEuro', max(0, $request->request->getInt('pointsPerEuro')));
+        $this->systemConfigService->set(self::DOMAIN . 'expiryDays', max(0, $request->request->getInt('expiryDays')));
+        $this->systemConfigService->set(self::DOMAIN . 'defaultTierId', Uuid::isValid($tierId) ? $tierId : null);
+
+        return new Response(null, Response::HTTP_NO_CONTENT);
+    }
+}
