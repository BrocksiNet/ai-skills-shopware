    {
      "name": "sw-architecture",
      "summary": "Use when introducing a new Shopware architecture, or when a change can break an existing one without the diff saying so.",
      "contexts": [
        "core",
        "plugin",
        "app",
        "project"
      ],
      "tasks": [
        "build",
        "review"
      ],
      "load_for": [],
      "paths": [],
      "defers_to": [
        "shopware-php-code"
      ],
      "routes": [
        {
          "reference": "sw-architecture/references/progressive-enhancement.md",
          "when": "A change must roll out without breaking existing callers.",
          "anchors_any": [
            "Feature::isActive\\(",
            "@deprecated tag:v"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/component-independence.md",
          "when": "A change couples two components or bundles.",
          "anchors_any": [
            "use Shopware\\\\(Storefront|Administration|Elasticsearch)\\\\"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md",
            "src/Storefront/**",
            "src/Administration/**",
            "src/Elasticsearch/**"
          ]
        },
        {
          "reference": "sw-architecture/references/dal-contracts.md",
          "when": "You touch a DAL definition, entity or repository contract.",
          "paths_any": [
            "**/*Definition.php",
            "**/*EntityExtension.php"
          ],
          "anchors_any": [
            "extends (Entity|EntityTranslation|MappingEntity)Definition",
            "extends EntityExtension",
            "EntityRepository"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/symfony-in-shopware.md",
          "when": "You reach for a Symfony component or container feature, or a service keeps state in a property.",
          "anchors_any": [
            "HttpClientInterface",
            "ClockInterface",
            "MessageBusInterface",
            "ResetInterface",
            "kernel\\.reset",
            "\\$this->[A-Za-z]+\\[[^\\]]+\\] \\?\\?="
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/extension-mechanisms.md",
          "when": "You choose between an event, a decoration and a core edit, or change an event.",
          "paths_any": [
            "**/*Event.php",
            "**/Resources/config/services.{xml,php}"
          ],
          "anchors_any": [
            "decorates",
            "#\\[AsEventListener",
            "getSubscribedEvents\\(",
            "ExtensionDispatcher",
            "extends (Event|Extension|NestedEvent)\\b"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/anti-patterns.md",
          "when": "You check a design against known mistakes.",
          "paths_any": [
            "**/vendor/shopware/**"
          ],
          "anchors_any": [
            "Doctrine\\\\DBAL\\\\Connection",
            "Feature::fake\\("
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/pattern-catalog.md",
          "when": "You need an established pattern or want to propose one.",
          "anchors_any": [
            "[ (!]time\\(\\)",
            "CacheTagsEvent",
            "#\\[CoversNothing\\]"
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        }
      ]
