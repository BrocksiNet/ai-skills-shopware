@@ -0,0 +1,19 @@
+import formatPoints from '@loyalty/format-points';
+import template from './swag-loyalty-customer-points.html.twig';
+
+Shopware.Component.register('swag-loyalty-customer-points', {
+    template,
+
+    props: {
+        points: {
+            type: Number,
+            required: true,
+        },
+    },
+
+    computed: {
+        formattedPoints() {
+            return formatPoints(this.points, Shopware.State.get('session').currentLocale);
+        },
+    },
+});
