diff --git a/src/Core/Checkout/SalesChannel/GiftWrapAddRoute.php b/src/Core/Checkout/SalesChannel/GiftWrapAddRoute.php
new file mode 100644
--- /dev/null
+++ b/src/Core/Checkout/SalesChannel/GiftWrapAddRoute.php
@@ -0,0 +1,26 @@
+<?php declare(strict_types=1);
+
+namespace Swag\GiftWrap\Core\Checkout\SalesChannel;
+
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+use Swag\GiftWrap\Checkout\GiftWrapService;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['store-api']])]
+class GiftWrapAddRoute
+{
+    public function __construct(private readonly GiftWrapService $giftWrap)
+    {
+    }
+
+    #[Route(path: '/store-api/checkout/gift-wrap', name: 'store-api.checkout.gift-wrap.add', methods: ['POST'])]
+    public function add(Request $request, SalesChannelContext $context): Response
+    {
+        $this->giftWrap->add((string) $request->request->get('lineItemId'), $context);
+
+        return new JsonResponse(null, Response::HTTP_NO_CONTENT);
+    }
+}
