+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\ScheduledTask;
+
+use Shopware\Core\Framework\MessageQueue\ScheduledTask\ScheduledTask;
+
+class ExpiryReminderTask extends ScheduledTask
+{
+    public static function getTaskName(): string
+    {
+        return 'swag_loyalty.expiry_reminder';
+    }
+
+    public static function getDefaultInterval(): int
+    {
+        return self::DAILY;
+    }
+}
diff --git a/src/ScheduledTask/ExpiryReminderTaskHandler.php b/src/ScheduledTask/ExpiryReminderTaskHandler.php
