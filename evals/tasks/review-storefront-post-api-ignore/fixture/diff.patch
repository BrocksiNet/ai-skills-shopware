+namespace Swag\GiftWrap\Core\Checkout\SalesChannel;
+
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+use Swag\GiftWrap\Checkout\GiftWrapService;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['store-api']])]
+class GiftWrapOptionsRoute
+{
+    public function __construct(private readonly GiftWrapService $giftWrap)
+    {
+    }
+
+    #[Route(path: '/store-api/gift-wrap', name: 'store-api.gift-wrap.options', methods: ['GET'])]
