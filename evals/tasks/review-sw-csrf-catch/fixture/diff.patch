diff --git a/src/Resources/views/storefront/page/account/loyalty/index.html.twig b/src/Resources/views/storefront/page/account/loyalty/index.html.twig
new file mode 100644
index 0000000..7b6e8bb
--- /dev/null
+++ b/src/Resources/views/storefront/page/account/loyalty/index.html.twig
@@ -0,0 +1,34 @@
+{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}
+
+{% block page_account_main_content %}
+    <div class="account-loyalty">
+        <h1 class="account-welcome">{{ 'swag-loyalty.account.title'|trans|sw_sanitize }}</h1>
+
+        <p class="account-loyalty-balance">
+            {{ 'swag-loyalty.account.balance'|trans({ '%points%': points })|sw_sanitize }}
+        </p>
+
+        <form action="{{ path('frontend.loyalty.redeem') }}"
+              method="post"
+              class="account-loyalty-redeem">
+            {{ sw_csrf('frontend.loyalty.redeem') }}
+
+            <div class="form-group">
+                <label class="form-label" for="loyaltyRedeemPoints">
+                    {{ 'swag-loyalty.account.redeemLabel'|trans|sw_sanitize }}
+                </label>
+                <input type="number"
+                       class="form-control"
+                       id="loyaltyRedeemPoints"
+                       name="points"
+                       min="1"
+                       max="{{ points }}"
+                       required>
+            </div>
+
+            <button type="submit" class="btn btn-primary">
+                {{ 'swag-loyalty.account.redeemSubmit'|trans|sw_sanitize }}
+            </button>
+        </form>
+    </div>
+{% endblock %}
