--- /dev/null
+++ b/src/ScheduledTask/ExpiryReminderTaskHandler.php
@@ -0,0 +1,41 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\ScheduledTask;
+
+use Psr\Log\LoggerInterface;
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\MessageQueue\ScheduledTask\ScheduledTaskHandler;
+use Shopware\Core\System\SystemConfig\SystemConfigService;
+use Swag\Loyalty\Service\ExpiryReminderMailer;
+use Swag\Loyalty\Service\LoyaltyPointsService;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+#[AsMessageHandler(handles: ExpiryReminderTask::class)]
+class ExpiryReminderTaskHandler extends ScheduledTaskHandler
+{
+    public function __construct(
+        EntityRepository $scheduledTaskRepository,
+        LoggerInterface $exceptionLogger,
+        private readonly LoyaltyPointsService $pointsService,
+        private readonly ExpiryReminderMailer $mailer,
+        private readonly SystemConfigService $systemConfigService,
+    ) {
+        parent::__construct($scheduledTaskRepository, $exceptionLogger);
+    }
+
+    public function run(): void
+    {
+        if (!$this->systemConfigService->getBool('SwagLoyalty.config.expiryReminderEnabled')) {
+            return;
+        }
+
+        $days = $this->systemConfigService->getInt('SwagLoyalty.config.expiryReminderDays');
+        $until = new \DateTimeImmutable(\sprintf('+%d days', $days));
+        $context = Context::createCLIContext();
+
+        foreach ($this->pointsService->findCustomersWithExpiringPoints($until, $context) as $customerId) {
+            $this->mailer->send($customerId, $until, $context);
+        }
+    }
+}
diff --git a/src/Service/ExpiryReminderMailer.php b/src/Service/ExpiryReminderMailer.php
