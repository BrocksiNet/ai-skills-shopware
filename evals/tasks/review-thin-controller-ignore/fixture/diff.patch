+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Controller;
+
+use OpenApi\Attributes as OA;
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+use Swag\Loyalty\Service\LoyaltyBalanceCalculator;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['store-api']])]
+class LoyaltyBalanceController
+{
+    public function __construct(
+        private readonly LoyaltyBalanceCalculator $balanceCalculator,
+    ) {
+    }
+
+    #[Route(
+        path: '/store-api/loyalty/balance',
+        name: 'store-api.swag-loyalty.balance',
+        defaults: ['_loginRequired' => true],
+        methods: ['GET'],
+    )]
+    #[OA\Get(
+        path: '/store-api/loyalty/balance',
+        operationId: 'readLoyaltyBalance',
+        description: 'Points balance and tier of the logged-in customer.',
+        tags: ['Store API', 'Loyalty'],
+        responses: [
+            new OA\Response(
+                response: 200,
+                description: 'Balance and tier',
+                content: new OA\JsonContent(properties: [
+                    new OA\Property(property: 'points', type: 'integer'),
+                    new OA\Property(property: 'tier', type: 'string', enum: ['bronze', 'silver', 'gold']),
+                ]),
+            ),
+        ],
+    )]
+    public function balance(SalesChannelContext $context): JsonResponse
+    {
+        $balance = $this->balanceCalculator->forCustomer($context->getCustomerId(), $context->getContext());
+
+        return new JsonResponse(['points' => $balance->points, 'tier' => $balance->tier]);
+    }
+}
