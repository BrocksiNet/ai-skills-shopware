+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Content\Product\SalesChannel\Price;
+
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+
+#[Package('inventory')]
+class ProductPriceBatchCalculator
+{
+    public function __construct(private readonly PriceRuleMatcher $matcher)
+    {
+    }
+
+    /**
+     * Calculates prices for many products at once and matches price rules once per batch.
+     *
+     * @param iterable<SalesChannelProductEntity> $products
+     */
+    public function calculate(iterable $products, SalesChannelContext $context): void
+    {
+        $rules = $this->matcher->match($context);
+        foreach ($products as $product) {
+            $product->setCalculatedPrices($rules->pricesFor($product));
+        }
+    }
+}
