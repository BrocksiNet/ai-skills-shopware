+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Subscriber;
+
+use Psr\Log\LoggerInterface;
+use Swag\LowStockDigest\Event\LowStockDigestPrintedEvent;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+class LowStockDigestLogSubscriber implements EventSubscriberInterface
+{
+    public function __construct(private readonly LoggerInterface $logger)
+    {
+    }
+
+    /**
+     * @return array<string, string>
+     */
+    public static function getSubscribedEvents(): array
+    {
+        return [
+            LowStockDigestPrintedEvent::class => 'onDigestPrinted',
+        ];
+    }
+
+    public function onDigestPrinted(LowStockDigestPrintedEvent $event): void
+    {
+        $productIds = $event->getProductIds();
+
+        if ($productIds === []) {
+            return;
+        }
+
+        $this->logger->info('Low stock digest printed', [
+            'products' => count($productIds),
+            'productIds' => $productIds,
+        ]);
+    }
+}
