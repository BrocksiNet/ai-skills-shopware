{
  "core": {
    "runner": "podman",
    "commands": [
      [
        "podman",
        "compose",
        "exec",
        "web",
        "vendor/bin/phpunit",
        "--filter",
        "CartProcessorTest"
      ],
      [
        "podman",
        "compose",
        "exec",
        "web",
        "composer",
        "phpstan"
      ]
    ]
  },
  "shop": {
    "runner": "shopware-cli",
    "commands": [
      [
        "shopware-cli",
        "project",
        "validate",
        "--reporter",
        "json"
      ]
    ]
  },
  "plugin": {
    "runner": "shopware-cli",
    "commands": [
      [
        "shopware-cli",
        "extension",
        "validate",
        ".",
        "--reporter",
        "json"
      ]
    ]
  },
  "site": {
    "runner": "project-native",
    "commands": [
      [
        "npm",
        "run",
        "check"
      ]
    ]
  }
}
