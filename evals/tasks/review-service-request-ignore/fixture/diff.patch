+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Content\Product\Review;
+
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\Log\Package;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * @internal
+ */
+#[Package('inventory')]
+class ProductReviewCsvController
+{
+    public function __construct(private readonly ProductReviewCsvExporter $exporter)
+    {
+    }
+
+    public function export(Request $request, Context $context): Response
+    {
+        $productIds = array_filter(explode(',', (string) $request->query->get('productIds', '')));
+        $csv = $this->exporter->export($productIds, $request->query->getBoolean('withHeader'), $context);
+
+        return new Response($csv, Response::HTTP_OK, ['Content-Type' => 'text/csv']);
+    }
+}
