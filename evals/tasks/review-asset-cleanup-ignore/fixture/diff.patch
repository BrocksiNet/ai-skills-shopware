+<?php declare(strict_types=1);
+
+namespace Shopware\Storefront\Theme\Message;
+
+use League\Flysystem\FilesystemOperator;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Storefront\Theme\ThemeHashStore;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+#[AsMessageHandler]
+#[Package('storefront')]
+class DeleteRetiredThemeDirectoriesHandler
+{
+    private const RETENTION = '-7 days';
+
+    public function __construct(
+        private readonly FilesystemOperator $themeFilesystem,
+        private readonly ThemeHashStore $hashStore,
+    ) {
+    }
+
+    public function __invoke(DeleteRetiredThemeDirectoriesMessage $message): void
+    {
+        foreach ($this->hashStore->retiredBefore(new \DateTimeImmutable(self::RETENTION)) as $hash) {
+            $this->themeFilesystem->deleteDirectory(sprintf('theme/%s', $hash));
+            $this->hashStore->forget($hash);
+        }
+    }
+}
