+<?php declare(strict_types=1);
+
+namespace Swag\CustomerPrices\Subscriber;
+
+use Shopware\Core\Framework\Adapter\Cache\Event\HttpCacheCookieEvent;
+use Swag\CustomerPrices\Service\CustomerPriceLoader;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+use Symfony\Component\HttpKernel\Event\ResponseEvent;
+use Symfony\Component\HttpKernel\KernelEvents;
+
+class PriceGroupCacheSubscriber implements EventSubscriberInterface
+{
+    public const PRICE_GROUP = 'swag-price-group';
+
+    private const VARIANT_ATTRIBUTE = '_swag_cache_variant';
+
+    public function __construct(private readonly CustomerPriceLoader $priceLoader)
+    {
+    }
+
+    public static function getSubscribedEvents(): array
+    {
+        return [
+            HttpCacheCookieEvent::class => 'onCacheCookie',
+            KernelEvents::RESPONSE => 'onResponse',
+        ];
+    }
+
+    public function onCacheCookie(HttpCacheCookieEvent $event): void
+    {
+        $priceGroupId = $this->priceLoader->priceGroupId($event->context);
+        if ($priceGroupId !== null) {
+            $event->add(self::PRICE_GROUP, $priceGroupId);
+        }
+
+        // The header shows which cache variant served the page.
+        $event->request->attributes->set(self::VARIANT_ATTRIBUTE, $event->getHash());
+    }
+
+    public function onResponse(ResponseEvent $event): void
+    {
+        $variant = $event->getRequest()->attributes->get(self::VARIANT_ATTRIBUTE);
+        if (\is_string($variant)) {
+            $event->getResponse()->headers->set('X-Swag-Cache-Variant', $variant);
+        }
+    }
+}
