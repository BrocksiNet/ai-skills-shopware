diff --git a/src/Storefront/Controller/GiftWrapController.php b/src/Storefront/Controller/GiftWrapController.php
new file mode 100644
--- /dev/null
+++ b/src/Storefront/Controller/GiftWrapController.php
@@ -0,0 +1,26 @@
+<?php declare(strict_types=1);
+
+namespace Swag\GiftWrap\Storefront\Controller;
+
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+use Shopware\Storefront\Controller\StorefrontController;
+use Swag\GiftWrap\Checkout\GiftWrapService;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['storefront']])]
+class GiftWrapController extends StorefrontController
+{
+    public function __construct(private readonly GiftWrapService $giftWrap)
+    {
+    }
+
+    #[Route(path: '/checkout/gift-wrap', name: 'frontend.checkout.gift-wrap.add', methods: ['POST'])]
+    public function add(Request $request, SalesChannelContext $context): Response
+    {
+        $this->giftWrap->add((string) $request->request->get('lineItemId'), $context);
+
+        return $this->redirectToRoute('frontend.checkout.cart.page');
+    }
+}
