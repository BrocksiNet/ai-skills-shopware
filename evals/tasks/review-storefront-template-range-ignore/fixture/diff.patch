@@ -0,0 +1,15 @@
+{% sw_extends '@Storefront/storefront/layout/navigation/flyout.html.twig' %}
+
+{% block layout_navigation_flyout_bar_category %}
+    {{ parent() }}
+    {% set teaser = category.extensions.swagNavigationTeaser.media ?? null %}
+    {% if teaser %}
+        <div class="col-auto swag-navigation-teaser">
+            {% sw_thumbnails 'swag-navigation-teaser-thumbnails' with {
+                media: teaser,
+                sizes: { default: '200px' },
+                attributes: { class: 'swag-navigation-teaser-image', alt: 'swagNavigationTeaser.imageAlt'|trans({ '%name%': name })|striptags }
+            } %}
+        </div>
+    {% endif %}
+{% endblock %}
