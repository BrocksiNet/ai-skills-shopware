@@ -0,0 +1,24 @@
+import FlyoutMenuPlugin from 'src/plugin/main-menu/flyout-menu.plugin';
+
+/**
+ * Opens a flyout only after the pointer rests on its trigger, so that
+ * moving across the navigation does not flash every flyout.
+ */
+export default class HoverIntentFlyoutPlugin extends FlyoutMenuPlugin {
+    static options = {
+        ...FlyoutMenuPlugin.options,
+        openDelay: 150,
+    };
+
+    _openFlyout(flyoutEl, triggerEl) {
+        window.clearTimeout(this._intentTimer);
+        this._intentTimer = window.setTimeout(() => {
+            super._openFlyout(flyoutEl, triggerEl);
+        }, this.options.openDelay);
+    }
+
+    _closeFlyout(flyoutEl, triggerEl) {
+        window.clearTimeout(this._intentTimer);
+        super._closeFlyout(flyoutEl, triggerEl);
+    }
+}
