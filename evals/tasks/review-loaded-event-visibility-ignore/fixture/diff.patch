 namespace Swag\ShopHealth\Check;
 
+use Shopware\Core\Content\Category\CategoryCollection;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Filter\EqualsFilter;
+use Shopware\Core\System\SalesChannel\Entity\SalesChannelRepository;
 use Shopware\Core\System\SalesChannel\SalesChannelContext;
 
 /**
@@ -10,10 +14,35 @@ use Shopware\Core\System\SalesChannel\SalesChannelContext;
 class CategoryProbe
 {
     /**
+     * @param SalesChannelRepository<CategoryCollection> $categoryRepository
+     */
+    public function __construct(private readonly SalesChannelRepository $categoryRepository)
+    {
+    }
+
+    /**
+     * The first candidate a customer of this sales channel can open, so the
+     * check does not fail on a category the shop hides on purpose.
+     *
      * @param list<string> $candidateIds navigation children first, then the navigation root
      */
     public function pick(array $candidateIds, SalesChannelContext $context): ?string
     {
-        return $candidateIds[0] ?? null;
+        if ($candidateIds === []) {
+            return null;
+        }
+
+        $criteria = new Criteria($candidateIds);
+        $criteria->addFilter(new EqualsFilter('active', true));
+
+        $categories = $this->categoryRepository->search($criteria, $context)->getEntities();
+
+        foreach ($candidateIds as $candidateId) {
+            if ($categories->get($candidateId)?->getActive()) {
+                return $candidateId;
+            }
+        }
+
+        return null;
     }
 }
