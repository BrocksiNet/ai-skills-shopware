+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Migration\Test;
+
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Test\TestCaseBase\KernelTestBehaviour;
+use Shopware\Core\Migration\Migration1792800456DropLegacyCustomerNote;
+
+#[Package('core')]
+#[CoversClass(Migration1792800456DropLegacyCustomerNote::class)]
+class Migration1792800456DropLegacyCustomerNoteTest extends TestCase
+{
+    use KernelTestBehaviour;
+
+    private Connection $connection;
+
+    protected function setUp(): void
+    {
+        $this->connection = $this->getContainer()->get(Connection::class);
+    }
+
+    public function testUpdateDestructiveDropsLegacyNoteColumn(): void
+    {
+        $this->connection->executeStatement('ALTER TABLE `customer` ADD COLUMN `note` LONGTEXT NULL');
+
+        (new Migration1792800456DropLegacyCustomerNote())->updateDestructive($this->connection);
+
+        $columns = $this->connection->fetchFirstColumn("SHOW COLUMNS FROM `customer` LIKE 'note'");
+
+        static::assertSame([], $columns);
+    }
+}
