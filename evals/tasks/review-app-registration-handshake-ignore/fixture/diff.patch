+        $signature = $request->headers->get('shopware-app-signature');
+        $queryString = $request->getQueryString() ?? '';
+        $expected = hash_hmac('sha256', $queryString, $this->appSecret);
+        if (!\is_string($signature) || !hash_equals($expected, $signature)) {
+            return new JsonResponse(['error' => 'Invalid signature'], Response::HTTP_UNAUTHORIZED);
+        }
+
+        $shopId = (string) $request->query->get('shop-id', '');
+        $shopUrl = (string) $request->query->get('shop-url', '');
+        $timestamp = (string) $request->query->get('timestamp', '');
+
+        if ($shopId === '' || $shopUrl === '' || $timestamp === '') {
+            return new JsonResponse(['error' => 'Missing registration parameters'], Response::HTTP_BAD_REQUEST);
+        }
+
+        $scheme = parse_url($shopUrl, \PHP_URL_SCHEME);
+        if (filter_var($shopUrl, \FILTER_VALIDATE_URL) === false || !\in_array($scheme, ['https', 'http'], true)) {
+            return new JsonResponse(['error' => 'Invalid shop URL'], Response::HTTP_BAD_REQUEST);
+        }
+
+        $shopSecret = bin2hex(random_bytes(32));
+        $this->shops->upsertPending($shopId, $shopUrl, $shopSecret);
+
+        $proof = hash_hmac('sha256', $shopId . $shopUrl . $this->appName, $this->appSecret);
+
+        return new JsonResponse([
+            'proof' => $proof,
+            'secret' => $shopSecret,
+            'confirmation_url' => $this->confirmationUrl,
+        ]);
+    }
