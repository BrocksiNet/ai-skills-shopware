+
+    #[Route(
+        path: '/account/loyalty',
+        name: 'frontend.account.loyalty.page',
+        defaults: ['_loginRequired' => true, '_noStore' => true],
+        methods: ['GET']
+    )]
+    public function accountPage(CustomerEntity $customer, SalesChannelContext $context): Response
+    {
+        return $this->renderStorefront('@SwagLoyalty/storefront/page/account/loyalty/index.html.twig', [
+            'points' => $this->pointsService->getBalance($customer->getId(), $context->getContext()),
+        ]);
+    }
+
+    #[Route(
+        path: '/account/loyalty/redeem',
+        name: 'frontend.loyalty.redeem',
+        defaults: ['_loginRequired' => true],
+        methods: ['POST']
+    )]
+    public function redeem(Request $request, CustomerEntity $customer, SalesChannelContext $context): Response
+    {
+        try {
+            $this->pointsService->redeem($customer->getId(), $request->request->getInt('points'), $context->getContext());
+            $this->addFlash(self::SUCCESS, $this->trans('swag-loyalty.account.redeemSuccess'));
+        } catch (\InvalidArgumentException) {
+            $this->addFlash(self::DANGER, $this->trans('swag-loyalty.account.redeemNotEnoughPoints'));
+        }
+
+        return $this->redirectToRoute('frontend.account.loyalty.page');
+    }
