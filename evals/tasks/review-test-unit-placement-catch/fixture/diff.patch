+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Service;
+
+class LoyaltyCalculator
+{
+    private const UNITS_PER_POINT = 10;
+
+    public function pointsFor(float $orderTotal): int
+    {
+        if ($orderTotal <= 0) {
+            return 0;
+        }
+
+        return (int) floor($orderTotal / self::UNITS_PER_POINT);
+    }
+}
