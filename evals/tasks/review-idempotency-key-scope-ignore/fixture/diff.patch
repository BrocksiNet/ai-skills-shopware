diff --git a/src/Idempotency/IdempotencyStore.php b/src/Idempotency/IdempotencyStore.php
new file mode 100644
index 0000000..22226ba
--- /dev/null
+++ b/src/Idempotency/IdempotencyStore.php
@@ -0,0 +1,50 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Idempotency;
+
+use Doctrine\DBAL\Connection;
+use Shopware\Core\Defaults;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Uuid\Uuid;
+
+#[Package('checkout')]
+class IdempotencyStore
+{
+    public function __construct(private readonly Connection $connection)
+    {
+    }
+
+    /**
+     * @return array{requestHash: string, response: array<string, mixed>}|null
+     */
+    public function find(string $callerId, string $key): ?array
+    {
+        $row = $this->connection->fetchAssociative(
+            'SELECT `request_hash`, `response` FROM `swag_loyalty_idempotency`
+             WHERE `caller_id` = :callerId AND `idempotency_key` = :key',
+            ['callerId' => Uuid::fromHexToBytes($callerId), 'key' => $key],
+        );
+
+        if ($row === false || !\is_string($row['request_hash']) || !\is_string($row['response'])) {
+            return null;
+        }
+
+        $decoded = json_decode($row['response'], true, 512, \JSON_THROW_ON_ERROR);
+
+        return \is_array($decoded) ? ['requestHash' => $row['request_hash'], 'response' => $decoded] : null;
+    }
+
+    /**
+     * @param array<string, mixed> $response
+     */
+    public function save(string $callerId, string $key, string $requestHash, array $response): void
+    {
+        $this->connection->insert('swag_loyalty_idempotency', [
+            'caller_id' => Uuid::fromHexToBytes($callerId),
+            'idempotency_key' => $key,
+            'request_hash' => $requestHash,
+            'response' => json_encode($response, \JSON_THROW_ON_ERROR),
+            'created_at' => (new \DateTimeImmutable())->format(Defaults::STORAGE_DATE_TIME_FORMAT),
+        ]);
+    }
+}
