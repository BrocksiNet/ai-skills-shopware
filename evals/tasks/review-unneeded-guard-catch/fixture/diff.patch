+<?php declare(strict_types=1);
+
+namespace Swag\MediaCdn\Subscriber;
+
+use Shopware\Core\Content\Media\Core\Event\UpdateMediaPathEvent;
+use Swag\MediaCdn\Service\CdnClient;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+class MediaPathPurgeSubscriber implements EventSubscriberInterface
+{
+    public function __construct(private readonly CdnClient $cdnClient)
+    {
+    }
+
+    public static function getSubscribedEvents(): array
+    {
+        return [UpdateMediaPathEvent::class => 'onUpdateMediaPath'];
+    }
+
+    public function onUpdateMediaPath(UpdateMediaPathEvent $event): void
+    {
+        $this->cdnClient->purgeMedia(array_values($event->ids));
+    }
+}
