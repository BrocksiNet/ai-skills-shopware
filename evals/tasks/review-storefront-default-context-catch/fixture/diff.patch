@@ -0,0 +1,32 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Subscriber;
+
+use Shopware\Storefront\Page\Account\Overview\AccountOverviewPageLoadedEvent;
+use Swag\Loyalty\Storefront\Pagelet\TierRecommendation\TierRecommendationPageletLoader;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+class AccountOverviewSubscriber implements EventSubscriberInterface
+{
+    public function __construct(
+        private readonly TierRecommendationPageletLoader $tierRecommendationLoader,
+    ) {
+    }
+
+    public static function getSubscribedEvents(): array
+    {
+        return [
+            AccountOverviewPageLoadedEvent::class => 'onAccountOverviewLoaded',
+        ];
+    }
+
+    public function onAccountOverviewLoaded(AccountOverviewPageLoadedEvent $event): void
+    {
+        $pagelet = $this->tierRecommendationLoader->load($event->getSalesChannelContext());
+        if ($pagelet === null) {
+            return;
+        }
+
+        $event->getPage()->addExtension('swagLoyaltyTierRecommendation', $pagelet);
+    }
+}
