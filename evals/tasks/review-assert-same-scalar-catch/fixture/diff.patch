+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Tests\Unit\Service;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Swag\Loyalty\Service\LoyaltyBalance;
+use Swag\Loyalty\Service\PointsLedger;
+
+/**
+ * @internal
+ */
+#[CoversClass(LoyaltyBalance::class)]
+class LoyaltyBalanceTest extends TestCase
+{
+    public function testBalanceIsTheLedgerSum(): void
+    {
+        $ledger = new class implements PointsLedger {
+            public function sumFor(string $customerId): string
+            {
+                return '120';
+            }
+        };
+
+        static::assertEquals(120, (new LoyaltyBalance($ledger))->forCustomer('customer-1'));
+    }
+}
