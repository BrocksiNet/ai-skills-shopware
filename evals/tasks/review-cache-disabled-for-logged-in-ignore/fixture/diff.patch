diff --git a/src/Resources/app/storefront/src/swag-loyalty-points/swag-loyalty-points.plugin.js b/src/Resources/app/storefront/src/swag-loyalty-points/swag-loyalty-points.plugin.js
new file mode 100644
index 0000000..b914976
--- /dev/null
+++ b/src/Resources/app/storefront/src/swag-loyalty-points/swag-loyalty-points.plugin.js
@@ -0,0 +1,23 @@
+import Plugin from 'src/plugin-system/plugin.class';
+
+/**
+ * Loads the customer's balance after first paint, so the product page HTML
+ * stays the same for everyone and stays in the HTTP cache.
+ */
+export default class SwagLoyaltyPointsPlugin extends Plugin {
+    static options = {
+        url: '',
+    };
+
+    async init() {
+        const response = await fetch(this.options.url, {
+            headers: { 'sw-access-key': window.accessKey, 'sw-context-token': window.contextToken },
+        });
+        if (!response.ok) {
+            return;
+        }
+
+        const balance = await response.json();
+        this.el.textContent = balance.points;
+    }
+}
