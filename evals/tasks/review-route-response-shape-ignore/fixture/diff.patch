+++ b/src/StoreApi/LoyaltyHistoryStruct.php
@@ -0,0 +1,30 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\StoreApi;
+
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Struct\Struct;
+
+#[Package('checkout')]
+final class LoyaltyHistoryStruct extends Struct
+{
+    /**
+     * @param list<array{date: \DateTimeImmutable, points: int, reason: string}> $entries
+     */
+    public function __construct(private readonly array $entries)
+    {
+    }
+
+    /**
+     * @return list<array{date: \DateTimeImmutable, points: int, reason: string}>
+     */
+    public function getEntries(): array
+    {
+        return $this->entries;
+    }
+
+    public function getApiAlias(): string
+    {
+        return 'swag_loyalty_history';
+    }
+}
