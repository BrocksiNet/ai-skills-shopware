@@ -0,0 +1,44 @@
+<?php declare(strict_types=1);
+
+namespace Shopware\Tests\Unit\Core\Content\Product\SalesChannel\Price;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Content\Product\SalesChannel\Price\MatchedPriceRules;
+use Shopware\Core\Content\Product\SalesChannel\Price\PriceRuleMatcher;
+use Shopware\Core\Content\Product\SalesChannel\Price\ProductPriceCalculatorV2;
+use Shopware\Core\Content\Product\SalesChannel\SalesChannelProductEntity;
+use Shopware\Core\Framework\DataAbstractionLayer\Pricing\PriceCollection;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+
+/**
+ * @internal
+ */
+#[Package('inventory')]
+#[CoversClass(ProductPriceCalculatorV2::class)]
+class ProductPriceCalculatorV2Test extends TestCase
+{
+    public function testMatchesRulesOnceAndSetsThePricesOfEveryProduct(): void
+    {
+        $context = $this->createMock(SalesChannelContext::class);
+        $first = new SalesChannelProductEntity();
+        $second = new SalesChannelProductEntity();
+        $firstPrices = new PriceCollection();
+        $secondPrices = new PriceCollection();
+
+        $rules = $this->createMock(MatchedPriceRules::class);
+        $rules->method('pricesFor')->willReturnMap([
+            [$first, $firstPrices],
+            [$second, $secondPrices],
+        ]);
+
+        $matcher = $this->createMock(PriceRuleMatcher::class);
+        $matcher->expects($this->once())->method('match')->with($context)->willReturn($rules);
+
+        (new ProductPriceCalculatorV2($matcher))->calculate([$first, $second], $context);
+
+        static::assertSame($firstPrices, $first->getCalculatedPrices());
+        static::assertSame($secondPrices, $second->getCalculatedPrices());
+    }
+}
