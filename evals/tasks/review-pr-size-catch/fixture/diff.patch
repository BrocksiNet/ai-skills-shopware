+
+    public function testCsvReplacesSemicolonsInNames(): void
+    {
+        $csv = (new LowStockDigestFormatter())->toCsv([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug; large', 'stock' => 3],
+        ]);
+
+        static::assertStringContainsString("SW-1;Mug, large;3\n", $csv);
+    }
+
+    public function testTableRowsKeepTheColumnOrder(): void
+    {
+        $rows = (new LowStockDigestFormatter())->toTableRows([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug', 'stock' => 1],
+        ]);
+
+        static::assertSame([['SW-1', 'Mug', '1']], $rows);
