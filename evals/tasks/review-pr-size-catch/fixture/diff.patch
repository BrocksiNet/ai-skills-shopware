@@ -0,0 +1,75 @@
+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Service;
+
+use Shopware\Core\Content\Product\ProductCollection;
+use Shopware\Core\Content\Product\ProductEntity;
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Filter\EqualsFilter;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Filter\RangeFilter;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Sorting\FieldSorting;
+use Shopware\Core\System\SystemConfig\SystemConfigService;
+
+/**
+ * Lists the active products whose stock is at or below the configured threshold.
+ */
+class LowStockDigestBuilder
+{
+    public const CONFIG_THRESHOLD = 'SwagLowStockDigest.config.threshold';
+    public const DEFAULT_THRESHOLD = 5;
+    public const PAGE_SIZE = 100;
+
+    /**
+     * @param EntityRepository<ProductCollection> $productRepository
+     */
+    public function __construct(
+        private readonly EntityRepository $productRepository,
+        private readonly SystemConfigService $systemConfigService,
+    ) {
+    }
+
+    /**
+     * @return list<array{id: string, productNumber: string, name: string|null, stock: int}>
+     */
+    public function build(Context $context, ?string $salesChannelId = null): array
+    {
+        $threshold = $this->threshold($salesChannelId);
+
+        $criteria = new Criteria();
+        $criteria->addFilter(new EqualsFilter('active', true));
+        $criteria->addFilter(new RangeFilter('stock', ['lte' => $threshold]));
+        $criteria->addSorting(new FieldSorting('stock', FieldSorting::ASCENDING));
+        $criteria->setLimit(self::PAGE_SIZE);
+
+        $result = $this->productRepository->search($criteria, $context);
+
+        $rows = [];
+        foreach ($result->getEntities() as $product) {
+            $rows[] = $this->row($product);
+        }
+
+        return $rows;
+    }
+
+    public function threshold(?string $salesChannelId = null): int
+    {
+        $value = $this->systemConfigService->getInt(self::CONFIG_THRESHOLD, $salesChannelId);
+
+        return $value > 0 ? $value : self::DEFAULT_THRESHOLD;
+    }
+
+    /**
+     * @return array{id: string, productNumber: string, name: string|null, stock: int}
+     */
+    private function row(ProductEntity $product): array
+    {
+        return [
+            'id' => $product->getId(),
+            'productNumber' => (string) $product->getProductNumber(),
+            'name' => $product->getTranslated()['name'] ?? null,
+            'stock' => $product->getStock(),
+        ];
+    }
+}
