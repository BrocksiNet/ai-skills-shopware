    {
      "name": "sw-admin-js",
      "summary": "Apply Shopware 6 Administration rules for JS, TypeScript, Vue, and Jest.",
      "contexts": [
        "core",
        "plugin",
        "app",
        "project"
      ],
      "tasks": [
        "build",
        "review"
      ],
      "load_for": [],
      "paths": [],
      "defers_to": [
        "shopware-admin-js"
      ],
      "routes": [
        {
          "reference": "sw-admin-js/references/architecture.md",
          "when": "You add a module, component override or ACL privilege.",
          "paths_any": [
            "**/Resources/app/administration/src/module/**",
            "**/Resources/app/administration/src/**/acl/index.{js,ts}"
          ],
          "anchors_any": [
            "Shopware\\.Module\\.register\\(",
            "Shopware\\.Component\\.(override|extend|register)\\(",
            "addPrivilegeMappingEntry\\(",
            "system_config:(read|update)",
            "enrichPrivileges\\("
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        },
        {
          "reference": "sw-admin-js/references/extension-api.md",
          "when": "You change a shipped component, template block or position identifier.",
          "paths_any": [
            "**/blocks-list.json"
          ],
          "anchors_any": [
            "positionIdentifier",
            "swDefinePublic\\(",
            "Component\\.override\\("
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        },
        {
          "reference": "sw-admin-js/references/testing.md",
          "when": "You write or fix a Jest spec.",
          "paths_any": [
            "**/Resources/app/administration/**/*.spec.{js,ts}"
          ],
          "anchors_any": [
            "shallowMount\\(",
            "flushPromises\\("
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        },
        {
          "reference": "sw-admin-js/references/flags-and-modern-web.md",
          "when": "A change needs a feature flag, a deprecation or a modern web API.",
          "anchors_any": [
            "Shopware\\.Feature\\.isActive\\(",
            "Shopware\\.Utils\\.debug\\.warn\\(",
            "<dialog[ >]",
            "\\bpopover="
          ],
          "exclude_paths": [
            "**/*.md"
          ]
        }
      ]
    },
