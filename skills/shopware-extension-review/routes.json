    "plugin",
    "app"
  ],
  "routes": [
    {
      "reference": "references/lenses.md",
      "when": "Any review: backward compatibility, cache, queue, security and test questions, and the core-only rules to skip.",
      "always": true
    },
    {
      "reference": "references/output.md",
      "when": "Writing the findings.",
      "always": true
    },
    {
