{
  "name": "ai-skills-shopware-tools",
  "private": true,
  "description": "Repo tooling for the skills library (rule catalog checks, renderers, eval plan/gate/diff). Runs on Node's built-in TypeScript type stripping; no build step.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate-rules": "node bin/validate-rules.ts",
    "render-enforced": "node bin/render-enforced.ts",
    "render-routes": "node bin/render-routes.ts",
    "validate-routes": "node bin/validate-routes.ts",
    "route": "node bin/route.ts",
    "eval-plan": "node bin/eval-plan.ts",
    "eval-gate": "node bin/eval-gate.ts",
    "eval-diff": "node bin/eval-diff.ts",
    "grade": "node bin/grade.ts",
    "mine-trunk": "node bin/mine-trunk.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src bin test graders api-index/src api-index/bin api-index/test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
