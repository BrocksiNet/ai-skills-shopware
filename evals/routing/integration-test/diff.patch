+<?php declare(strict_types=1);
+
+namespace Shopware\Tests\Integration\Core\Content\Loyalty;
+
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Framework\Test\TestCaseBase\IntegrationTestBehaviour;
+
+class LoyaltyRepositoryTest extends TestCase
+{
+    use IntegrationTestBehaviour;
+
+    public function testWritesPoints(): void
+    {
+        $repository = static::getContainer()->get('customer.repository');
+        $repository->upsert([['id' => $this->customerId, 'customFields' => ['loyalty' => 5]]], Context::createDefaultContext());
+
+        static::assertSame(5, $this->loadPoints());
+    }
+}
