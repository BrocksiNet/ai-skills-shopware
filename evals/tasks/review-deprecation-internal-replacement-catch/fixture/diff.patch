diff --git a/src/Core/Content/Product/SalesChannel/Price/ProductPriceCalculatorV2.php b/src/Core/Content/Product/SalesChannel/Price/ProductPriceCalculatorV2.php
new file mode 100644
--- /dev/null
+++ b/src/Core/Content/Product/SalesChannel/Price/ProductPriceCalculatorV2.php
@@ -0,0 +1,38 @@
+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Content\Product\SalesChannel\Price;
+
+use Shopware\Core\Content\Product\SalesChannel\SalesChannelProductEntity;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Plugin\Exception\DecorationPatternException;
+use Shopware\Core\System\SalesChannel\SalesChannelContext;
+
+/**
+ * @internal
+ */
+#[Package('inventory')]
+class ProductPriceCalculatorV2 extends AbstractProductPriceCalculator
+{
+    public function __construct(private readonly PriceRuleMatcher $matcher)
+    {
+    }
+
+    public function getDecorated(): AbstractProductPriceCalculator
+    {
+        throw new DecorationPatternException(self::class);
+    }
+
+    /**
+     * Calculates the same prices as ProductPriceCalculator::calculate(), but
+     * matches the price rules once per batch instead of once per product.
+     *
+     * @param iterable<SalesChannelProductEntity> $products
+     */
+    public function calculate(iterable $products, SalesChannelContext $context): void
+    {
+        $rules = $this->matcher->match($context);
+        foreach ($products as $product) {
+            $product->setCalculatedPrices($rules->pricesFor($product));
+        }
+    }
+}
