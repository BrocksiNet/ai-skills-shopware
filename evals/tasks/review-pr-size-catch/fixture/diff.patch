+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Service;
+
+/**
+ * Renders the digest rows for the console table and the CSV export.
+ */
+class LowStockDigestFormatter
+{
+    /**
+     * @param list<array{id: string, productNumber: string, name: string|null, stock: int}> $rows
+     *
+     * @return list<list<string>>
+     */
+    public function toTableRows(array $rows): array
+    {
+        return array_map(
+            static fn (array $row): array => [$row['productNumber'], $row['name'] ?? '', (string) $row['stock']],
+            $rows,
+        );
+    }
+
+    /**
+     * @param list<array{id: string, productNumber: string, name: string|null, stock: int}> $rows
+     */
+    public function toCsv(array $rows): string
+    {
+        $lines = ['productNumber;name;stock'];
+
+        foreach ($rows as $row) {
+            $name = str_replace(';', ',', $row['name'] ?? '');
+            $lines[] = sprintf('%s;%s;%d', $row['productNumber'], $name, $row['stock']);
+        }
+
+        return implode("\n", $lines) . "\n";
+    }
+}
