+/**
+ * @sw-package checkout
+ */
+import swOrderLineItemsGrid from './index';
+
+function createContext() {
+    const lineItems = [{ id: 'first' }, { id: 'second' }];
+    lineItems.getIds = () => lineItems.map(({ id }) => id);
+    lineItems.remove = jest.fn();
+
+    return { order: { lineItems }, lastDeletedIndex: null, $emit: jest.fn() };
+}
+
+describe('module/sw-order/component/sw-order-line-items-grid', () => {
+    afterEach(() => {
+        global.activeFeatureFlags = [];
+    });
+
+    it('stores the passed itemIndex while v6.8.0.0 is off', () => {
+        global.activeFeatureFlags = [];
+        const context = createContext();
+
+        swOrderLineItemsGrid.methods.onDeleteItem.call(context, { id: 'second' }, 7);
+
+        expect(context.lastDeletedIndex).toBe(7);
+        expect(context.order.lineItems.remove).toHaveBeenCalledWith('second');
+    });
+
+    it('derives the index from the line items when v6.8.0.0 is on', () => {
+        global.activeFeatureFlags = ['v6.8.0.0'];
+        const context = createContext();
+
+        swOrderLineItemsGrid.methods.onDeleteItem.call(context, { id: 'second' }, 7);
+
+        expect(context.lastDeletedIndex).toBe(1);
+        expect(context.$emit).toHaveBeenCalledWith('item-delete', 'second');
+    });
+});
