+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Subscriber;
+
+use Shopware\Core\Checkout\Cart\Event\CheckoutOrderPlacedEvent;
+use Swag\Loyalty\LoyaltyLedger;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+use Symfony\Contracts\HttpClient\HttpClientInterface;
+
+/**
+ * Books the points of a new order and reports them to the merchant's ERP,
+ * which keeps the authoritative balance.
+ */
+class OrderPointsExportSubscriber implements EventSubscriberInterface
+{
+    public function __construct(
+        private readonly LoyaltyLedger $ledger,
+        private readonly HttpClientInterface $httpClient,
+        private readonly string $erpUrl,
+    ) {
+    }
+
+    public static function getSubscribedEvents(): array
+    {
+        return [CheckoutOrderPlacedEvent::class => 'onOrderPlaced'];
+    }
+
+    public function onOrderPlaced(CheckoutOrderPlacedEvent $event): void
+    {
+        $order = $event->getOrder();
+        $points = $this->ledger->book($order, $event->getContext());
+
+        $this->httpClient->request('POST', $this->erpUrl . '/loyalty/bookings', [
+            'json' => [
+                'orderNumber' => $order->getOrderNumber(),
+                'customerNumber' => $order->getOrderCustomer()?->getCustomerNumber(),
+                'points' => $points,
+            ],
+            'timeout' => 30,
+        ])->toArray();
+    }
+}
