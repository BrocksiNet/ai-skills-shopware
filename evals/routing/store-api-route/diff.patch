+<?php declare(strict_types=1);
+
+namespace Acme\Loyalty\Core\Content\Loyalty\SalesChannel;
+
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route(defaults: ['_routeScope' => ['store-api']])]
+class LoyaltyPointsRoute extends AbstractLoyaltyPointsRoute
+{
+    #[Route(path: '/store-api/loyalty/points', name: 'store-api.loyalty.points', methods: ['GET'])]
+    public function load(SalesChannelContext $context): LoyaltyPointsRouteResponse
+    {
+        return new LoyaltyPointsRouteResponse($this->points->forCustomer($context->getCustomerId()));
+    }
+}
