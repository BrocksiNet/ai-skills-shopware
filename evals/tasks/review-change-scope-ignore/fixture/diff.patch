+<?php declare(strict_types=1);
+
+namespace Swag\OrderTools\Tests\Unit\Shipping;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Checkout\Order\OrderDeliveryCollection;
+use Shopware\Core\Checkout\Order\OrderEntity;
+use Swag\OrderTools\Shipping\ShippingCostResolver;
+
+#[CoversClass(ShippingCostResolver::class)]
+class ShippingCostResolverTest extends TestCase
+{
+    public function testOrderWithoutDeliveryCostsNothing(): void
+    {
+        $order = new OrderEntity();
+        $order->setDeliveries(new OrderDeliveryCollection());
+
+        static::assertSame(0.0, (new ShippingCostResolver())->resolve($order));
+    }
+}
