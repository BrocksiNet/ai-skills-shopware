        "fixtures/fail/src/Resources/app/storefront/src/plugin/live-stock.plugin.js": "import Plugin from 'src/plugin-system/plugin.class';\nexport default class LiveStockPlugin extends Plugin {\n    static options = { endpoint: '/store-api/live-stock' };\n    init() { return this.load(); }\n    async load() {\n        this.controller = new AbortController();\n        try {\n            const response = await fetch(this.options.endpoint, { cache: 'no-store', signal: this.controller.signal });\n            this.el.innerHTML = await response.text();\n        } catch (error) { if (error.name !== 'AbortError') throw error; }\n    }\n    destroy() { super.destroy(); }\n}\n",
