+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Content\Product\Review;
+
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Filter\EqualsAnyFilter;
+use Shopware\Core\Framework\Log\Package;
+
+/**
+ * @internal
+ */
+#[Package('inventory')]
+class ProductReviewCsvExporter
+{
+    /**
+     * @param EntityRepository<ProductReviewCollection> $reviewRepository
+     */
+    public function __construct(private readonly EntityRepository $reviewRepository)
+    {
+    }
+
+    /**
+     * @param list<string> $productIds
+     */
+    public function export(array $productIds, bool $withHeader, Context $context): string
+    {
+        $criteria = new Criteria();
+        $criteria->addFilter(new EqualsAnyFilter('productId', $productIds));
+
+        $lines = $withHeader ? ['productId;points;title'] : [];
+        foreach ($this->reviewRepository->search($criteria, $context)->getEntities() as $review) {
+            $lines[] = implode(';', [$review->getProductId(), $review->getPoints(), $review->getTitle()]);
+        }
+
+        return implode("\n", $lines);
+    }
+}
