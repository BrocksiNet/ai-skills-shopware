 "repos/shopware/shopware/commits/0b0a7241dfa2780b8dd0d74189d49cee93713cd1": {
  "sha": "0b0a7241dfa2780b8dd0d74189d49cee93713cd1",
  "commit": {
   "message": "ci(danger): fail new unit test classes that compose helpers through a trait (#20840)",
   "committer": {
    "date": "2026-10-08T15:52:49Z"
   }
  },
  "parents": [
   {
    "sha": "9895c906a3d23d309ea39f4dedc6a38a1c9cc020"
   }
  ],
  "files": [
   {
    "filename": ".agents/skills/shopware-phpunit-tests/SKILL.md",
    "status": "modified",
    "additions": 1,
    "deletions": 0,
    "patch": "@@ -57,6 +57,7 @@ Tests should read like executable examples.\n+- Do not compose helpers into a unit test class through a trait; use a static fixture class or a stub under `Stub/`. Lifecycle behaviours (`EnvTestBehaviour`, `EventDispatcherBehaviour`, `ClockSensitiveTrait`) are the only allowed traits, a Danger rule fails new unit test files with any other."
   },
   {
    "filename": "coding-guidelines/core/unit-tests.md",
    "status": "modified",
    "additions": 1,
    "deletions": 0,
    "patch": "@@ -9,6 +9,7 @@ When writing unit tests, the following is important:\n+- **No traits in unit test classes** - A new unit test class does not compose helpers through a trait. Fixture builders go into a static fixture class such as `Shopware\\Core\\Test\\Checkout\\CartRuleFixture`, doubles of the class under test into a `Stub/` folder next to the test, and behaviours that boot the kernel stay out of the unit suite. The only traits a unit test class may use are lifecycle behaviours that must restore state after the test, such as `EnvTestBehaviour`, `EventDispatcherBehaviour` or Symfony's `ClockSensitiveTrait`. A Danger rule fails new unit test files composing any other trait; a stub class declared further down in the same file may still use a production trait it exercises."
   },
   {
    "filename": "src/Core/DevOps/StaticAnalyze/Danger/Rules/TraitUsageInNewUnitTests.php",
    "status": "added",
    "additions": 94,
    "deletions": 0
   }
  ]
 },
