{
  "name": "ai-skills-shopware-api-index",
  "private": true,
  "description": "Builds the public API index of shopware/shopware per release. Needs php-parser, so it is its own package; the tools that read the index have no dependencies.",
  "type": "module",
  "scripts": {
    "build": "node bin/build.ts",
    "bundle": "node bin/bundle.ts",
    "bundle:check": "node bin/bundle.ts --check",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "c8 node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@babel/parser": "8.1.2",
    "@babel/types": "8.1.2",
    "php-parser": "3.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
