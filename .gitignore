# Local review-signals cache, including private repositories (tools/bin/collect-reviews.ts)
.cache/

# Local eval/runner artifacts
evals/.runs/
evals/.results/
evals/**/.out/
evals/smoke/smoke.env
*.log

# Node (skills.sh runner helpers, markdown lint, eval AST toolchain)
node_modules/
evals/tools/ast/node_modules/
tools/node_modules/
.npm/

# OS
.DS_Store

# Local environment / secrets (never commit API keys for the eval harness)
.env
.env.*

# Local MCP plugin config (optional personal tooling; not part of the skills library)
.mcp-gh-tooling.json

# skills.sh CLI lockfile (local paths; use sw-dev link instead of npx skills add)
skills-lock.json
.agents/
