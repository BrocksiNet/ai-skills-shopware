 use Shopware\Core\Framework\Log\Package;
 use Symfony\Component\Cache\Adapter\AdapterInterface;
+use Symfony\Component\Cache\Adapter\ApcuAdapter;
 use Symfony\Component\Cache\Adapter\FilesystemAdapter;
+use Symfony\Component\DependencyInjection\Attribute\Autowire;

 /**
  * @internal
  */
 #[Package('core')]
 class CacheBackendFactory
 {
-    public function __construct(private readonly string $cacheDir)
-    {
+    public function __construct(
+        private readonly string $cacheDir,
+        #[Autowire('%shopware.cache.apcu%')]
+        private readonly bool $apcuEnabled,
+    ) {
+        if ($this->apcuEnabled && !function_exists('apcu_fetch')) {
+            throw new \RuntimeException('shopware.cache.apcu is enabled, but ext-apcu is not loaded. Install ext-apcu or set shopware.cache.apcu to false.');
+        }
     }

     public function create(string $namespace, int $lifetime): AdapterInterface
     {
+        if ($this->apcuEnabled) {
+            return new ApcuAdapter($namespace, $lifetime);
+        }
+
         return new FilesystemAdapter($namespace, $lifetime, $this->cacheDir);
     }
 }
