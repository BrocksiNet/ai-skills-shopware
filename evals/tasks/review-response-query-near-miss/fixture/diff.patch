+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Subscriber;
+
+use Doctrine\DBAL\Connection;
+use Shopware\Core\Framework\Event\BeforeSendResponseEvent;
+use Shopware\Core\PlatformRequest;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+/**
+ * Announces the loyalty program to agents and crawlers with a Link header on
+ * every storefront page of a sales channel that has the program switched on.
+ */
+class LoyaltyLinkHeaderSubscriber implements EventSubscriberInterface
+{
+    public function __construct(private readonly Connection $connection)
+    {
+    }
+
+    public static function getSubscribedEvents(): array
+    {
+        return [BeforeSendResponseEvent::class => 'addLinkHeader'];
+    }
+
+    public function addLinkHeader(BeforeSendResponseEvent $event): void
+    {
+        $response = $event->getResponse();
+        if (!str_starts_with((string) $response->headers->get('Content-Type'), 'text/html')) {
+            return;
+        }
+
+        $salesChannelId = $event->getRequest()->attributes->get(PlatformRequest::ATTRIBUTE_SALES_CHANNEL_ID);
+        if (!\is_string($salesChannelId)) {
+            return;
+        }
+
+        $active = $this->connection->fetchOne(
+            'SELECT active FROM swag_loyalty_config WHERE sales_channel_id = :id',
+            ['id' => hex2bin($salesChannelId)],
+        );
+
+        if ((bool) $active) {
+            $response->headers->set('Link', '</loyalty/program.json>; rel="loyalty-program"', false);
+        }
+    }
+}
