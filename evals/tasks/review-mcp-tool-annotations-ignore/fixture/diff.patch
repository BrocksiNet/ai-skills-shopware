@@ -0,0 +1,65 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Mcp\Tool;
+
+use Doctrine\DBAL\Connection;
+use Mcp\Capability\Attribute\McpTool;
+use Mcp\Capability\Attribute\Schema;
+use Mcp\Schema\ToolAnnotations;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolGroup;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolRequires;
+use Shopware\Core\Framework\Mcp\Context\McpContextProvider;
+use Shopware\Core\Framework\Mcp\Result\McpToolError;
+use Shopware\Core\Framework\Mcp\Result\McpToolResult;
+use Shopware\Core\Framework\Mcp\Tool\McpToolResponse;
+use Shopware\Core\Framework\Uuid\Uuid;
+use Swag\Loyalty\Service\LoyaltyBalanceWriter;
+
+#[McpTool(
+    name: 'swag-loyalty-reset-points',
+    title: 'Reset Loyalty Points',
+    annotations: new ToolAnnotations(readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false),
+    description: 'Reset a customer loyalty balance to zero. Defaults to dryRun=true.',
+)]
+#[McpToolGroup('swag-loyalty', description: 'Inspect and update customer loyalty points.')]
+#[McpToolRequires('swag_loyalty_points:update')]
+class ResetPointsTool extends McpToolResponse
+{
+    public function __construct(
+        private readonly Connection $connection,
+        private readonly LoyaltyBalanceWriter $balanceWriter,
+        private readonly McpContextProvider $contextProvider,
+    ) {
+    }
+
+    public function __invoke(
+        #[Schema(description: 'Customer UUID whose balance will be reset.')]
+        string $customerId,
+        #[Schema(description: 'Preview inside a rolled-back transaction when true.')]
+        bool $dryRun = true,
+    ): McpToolResult {
+        $context = $this->contextProvider->getContext();
+        $privilegeError = $this->requirePrivilegeResult($context, 'swag_loyalty_points:update');
+        if ($privilegeError !== null) {
+            return $privilegeError;
+        }
+
+        if (!Uuid::isValid($customerId)) {
+            return $this->errorResult('Invalid customer UUID.', McpToolError::INVALID_ARGUMENTS);
+        }
+
+        $op = function () use ($customerId, $context, $dryRun): McpToolResult {
+            $previousPoints = $this->balanceWriter->resetBalance($customerId, $context);
+            if ($previousPoints === null) {
+                return $this->errorResult('No loyalty balance found for customer.', McpToolError::NOT_FOUND);
+            }
+
+            return $this->successResult(
+                ['customerId' => $customerId, 'previousPoints' => $previousPoints, 'points' => 0],
+                ['dryRun' => $dryRun],
+            );
+        };
+
+        return $dryRun ? $this->executeWithDryRunResult($this->connection, $context, $op) : $op();
+    }
+}
