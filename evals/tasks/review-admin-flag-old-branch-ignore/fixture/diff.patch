+++ b/src/Resources/app/administration/src/module/swag-loyalty/service/points-rounding.ts
@@ -0,0 +1,5 @@
+export type PointsRounding = 'down' | 'nearest';
+
+export function roundPoints(raw: number, mode: PointsRounding): number {
+    return mode === 'nearest' ? Math.round(raw) : Math.floor(raw);
+}
