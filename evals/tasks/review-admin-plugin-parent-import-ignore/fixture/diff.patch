+{% block swag_loyalty_order_summary %}
+<div class="swag-loyalty-order-summary">
+    <span class="swag-loyalty-order-summary__balance">{{ formattedBalance }}</span>
+    <mt-button
+        variant="secondary"
+        @click="onRefresh"
+    >
+        {{ $tc('swag-loyalty.orderSummary.refresh') }}
+    </mt-button>
+</div>
+{% endblock %}
