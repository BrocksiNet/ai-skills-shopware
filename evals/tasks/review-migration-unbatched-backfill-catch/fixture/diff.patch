+<?php declare(strict_types=1);
+
+namespace Swag\Review\Migration;
+
+use Doctrine\DBAL\Connection;
+use Shopware\Core\Framework\Migration\MigrationStep;
+
+/**
+ * Moves the author name from swag_review_author onto swag_review; the old
+ * table is dropped in updateDestructive(). From this version on,
+ * ReviewPersister writes author_name and no longer touches swag_review_author.
+ */
+class Migration1729800000MoveReviewAuthorName extends MigrationStep
+{
+    public function getCreationTimestamp(): int
+    {
+        return 1729800000;
+    }
+
+    public function update(Connection $connection): void
+    {
+        if (!$this->columnExists($connection, 'swag_review', 'author_name')) {
+            $connection->executeStatement(
+                'ALTER TABLE `swag_review` ADD COLUMN `author_name` VARCHAR(255) NULL'
+            );
+        }
+
+        $connection->executeStatement(
+            'UPDATE `swag_review` r
+            INNER JOIN `swag_review_author` a ON a.`review_id` = r.`id`
+            SET r.`author_name` = a.`name`'
+        );
+    }
+
+    public function updateDestructive(Connection $connection): void
+    {
+        $connection->executeStatement('DROP TABLE IF EXISTS `swag_review_author`');
+    }
+}
