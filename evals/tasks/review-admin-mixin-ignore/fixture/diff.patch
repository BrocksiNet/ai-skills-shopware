diff --git a/src/Resources/app/administration/src/app/composable/loyalty-points.ts b/src/Resources/app/administration/src/app/composable/loyalty-points.ts
new file mode 100644
--- /dev/null
+++ b/src/Resources/app/administration/src/app/composable/loyalty-points.ts
@@ -0,0 +1,18 @@
+import { ref } from 'vue';
+
+export function useLoyaltyPoints(customerId: string) {
+    const loyaltyPoints = ref<number | null>(null);
+    const loyaltyLoading = ref(false);
+
+    async function loadLoyaltyPoints(): Promise<void> {
+        loyaltyLoading.value = true;
+
+        try {
+            loyaltyPoints.value = await Shopware.Service('loyaltyPointsService').getBalance(customerId);
+        } finally {
+            loyaltyLoading.value = false;
+        }
+    }
+
+    return { loyaltyPoints, loyaltyLoading, loadLoyaltyPoints };
+}
diff --git a/src/Resources/app/administration/src/module/swag-loyalty/component/swag-loyalty-points-badge/index.ts b/src/Resources/app/administration/src/module/swag-loyalty/component/swag-loyalty-points-badge/index.ts
new file mode 100644
--- /dev/null
+++ b/src/Resources/app/administration/src/module/swag-loyalty/component/swag-loyalty-points-badge/index.ts
@@ -0,0 +1,22 @@
+import template from './swag-loyalty-points-badge.html.twig';
+import { useLoyaltyPoints } from '../../../../app/composable/loyalty-points';
+
+const { Component } = Shopware;
+
+Component.register('swag-loyalty-points-badge', {
+    template,
+
+    props: {
+        customerId: {
+            type: String,
+            required: true,
+        },
+    },
+
+    setup(props) {
+        const points = useLoyaltyPoints(props.customerId);
+        points.loadLoyaltyPoints();
+
+        return points;
+    },
+});
