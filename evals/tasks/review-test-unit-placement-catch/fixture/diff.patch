+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Test\Integration\Service;
+
+use PHPUnit\Framework\TestCase;
+use Swag\Loyalty\Service\LoyaltyCalculator;
+
+class LoyaltyCalculatorTest extends TestCase
+{
+    public function testZeroTotalEarnsNoPoints(): void
+    {
+        $calculator = new LoyaltyCalculator();
+
+        static::assertSame(0, $calculator->pointsFor(0.0));
+    }
+
+    public function testOneFullUnitEarnsOnePoint(): void
+    {
+        $calculator = new LoyaltyCalculator();
+
+        static::assertSame(1, $calculator->pointsFor(10.0));
+    }
+
+    public function testPartialUnitRoundsDownToWholePoints(): void
+    {
+        $calculator = new LoyaltyCalculator();
+
+        static::assertSame(1, $calculator->pointsFor(19.99));
+    }
+}
