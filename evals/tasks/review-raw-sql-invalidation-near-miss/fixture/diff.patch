@@ -0,0 +1,30 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Tier;
+
+use Doctrine\DBAL\ArrayParameterType;
+use Doctrine\DBAL\Connection;
+use Shopware\Core\Framework\Uuid\Uuid;
+
+/**
+ * Bulk edit from the admin: raise or lower the thresholds of many tiers in
+ * one statement instead of one DAL update per tier.
+ */
+class TierThresholdUpdater
+{
+    public function __construct(private readonly Connection $connection)
+    {
+    }
+
+    /**
+     * @param list<string> $tierIds
+     */
+    public function shift(array $tierIds, int $delta): void
+    {
+        $this->connection->executeStatement(
+            'UPDATE swag_loyalty_tier SET threshold = GREATEST(0, threshold + :delta), updated_at = NOW(3) WHERE id IN (:ids)',
+            ['delta' => $delta, 'ids' => Uuid::fromHexToBytesList($tierIds)],
+            ['ids' => ArrayParameterType::BINARY],
+        );
+    }
+}
