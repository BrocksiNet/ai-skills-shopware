diff --git a/src/Resources/views/storefront/page/account/index.html.twig b/src/Resources/views/storefront/page/account/index.html.twig
new file mode 100644
index 0000000..3248fe2
--- /dev/null
+++ b/src/Resources/views/storefront/page/account/index.html.twig
@@ -0,0 +1,30 @@
+{% sw_extends '@Storefront/storefront/page/account/index.html.twig' %}
+
+{% block page_account_overview_newsletter %}
+    {{ parent() }}
+
+    {% set recommendation = page.extensions.swagLoyaltyTierRecommendation %}
+
+    {% if recommendation and recommendation.products|length > 0 %}
+        <div class="card account-loyalty-recommendation">
+            <div class="card-body">
+                <h2 class="card-title">
+                    {{ 'swag-loyalty.account.recommendedForTier'|trans({ '%tier%': recommendation.tierName })|sw_sanitize }}
+                </h2>
+
+                <ul class="list-unstyled account-loyalty-recommendation-list">
+                    {% for product in recommendation.products %}
+                        <li class="account-loyalty-recommendation-item">
+                            <a href="{{ seoUrl('frontend.detail.page', { productId: product.id }) }}">
+                                {{ product.translated.name }}
+                            </a>
+                            <span class="account-loyalty-recommendation-price">
+                                {{ product.price.first.gross|currency }}
+                            </span>
+                        </li>
+                    {% endfor %}
+                </ul>
+            </div>
+        </div>
+    {% endif %}
+{% endblock %}
