diff --git a/src/Resources/app/administration/src/module/swag-loyalty-tier/page/swag-loyalty-tier-list/index.js b/src/Resources/app/administration/src/module/swag-loyalty-tier/page/swag-loyalty-tier-list/index.js
new file mode 100644
index 0000000..303cac1
--- /dev/null
+++ b/src/Resources/app/administration/src/module/swag-loyalty-tier/page/swag-loyalty-tier-list/index.js
@@ -0,0 +1,47 @@
+import template from './swag-loyalty-tier-list.html.twig';
+
+const { Criteria } = Shopware.Data;
+
+Shopware.Component.register('swag-loyalty-tier-list', {
+    template,
+
+    inject: ['repositoryFactory', 'acl'],
+
+    data() {
+        return {
+            tiers: null,
+            isLoading: false,
+        };
+    },
+
+    computed: {
+        tierRepository() {
+            return this.repositoryFactory.create('swag_loyalty_tier');
+        },
+
+        columns() {
+            return [
+                { property: 'name', label: this.$tc('swag-loyalty-tier.list.columnName'), primary: true },
+                { property: 'minPoints', label: this.$tc('swag-loyalty-tier.list.columnMinPoints') },
+            ];
+        },
+    },
+
+    created() {
+        this.loadTiers();
+    },
+
+    methods: {
+        async loadTiers() {
+            this.isLoading = true;
+            const criteria = new Criteria(1, 25);
+            criteria.addSorting(Criteria.sort('minPoints', 'ASC'));
+
+            try {
+                this.tiers = await this.tierRepository.search(criteria);
+            } finally {
+                this.isLoading = false;
+            }
+        },
+    },
+});
