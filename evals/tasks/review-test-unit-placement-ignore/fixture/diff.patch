+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Test\Integration\Service;
+
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\Test\TestCaseBase\DatabaseTransactionBehaviour;
+use Shopware\Core\Framework\Test\TestCaseBase\KernelTestBehaviour;
+use Shopware\Core\Framework\Uuid\Uuid;
+use Swag\Loyalty\Service\LoyaltyPointWriter;
+
+class LoyaltyPointWriterTest extends TestCase
+{
+    use KernelTestBehaviour;
+    use DatabaseTransactionBehaviour;
+
+    public function testAwardStoresWholePointsForTheCustomer(): void
+    {
+        $writer = static::getContainer()->get(LoyaltyPointWriter::class);
+        $repository = static::getContainer()->get('swag_loyalty_account.repository');
+        $customerId = Uuid::randomHex();
+
+        $writer->award($customerId, 25.0, Context::createDefaultContext());
+
+        $account = $repository->search(new Criteria(), Context::createDefaultContext())->first();
+        static::assertSame(2, $account->get('points'));
+    }
+}
