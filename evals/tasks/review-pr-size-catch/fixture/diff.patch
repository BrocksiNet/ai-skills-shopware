+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Tests\Unit\Subscriber;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Psr\Log\LoggerInterface;
+use Shopware\Core\Framework\Context;
+use Swag\LowStockDigest\Event\LowStockDigestPrintedEvent;
+use Swag\LowStockDigest\Subscriber\LowStockDigestLogSubscriber;
+
+#[CoversClass(LowStockDigestLogSubscriber::class)]
+class LowStockDigestLogSubscriberTest extends TestCase
+{
+    public function testLogsTheProductCount(): void
+    {
+        $logger = $this->createMock(LoggerInterface::class);
+        $logger->expects(static::once())
+            ->method('info')
+            ->with('Low stock digest printed', [
+                'products' => 2,
+                'productIds' => ['a', 'b'],
+            ]);
+
+        $subscriber = new LowStockDigestLogSubscriber($logger);
+        $subscriber->onDigestPrinted(new LowStockDigestPrintedEvent(['a', 'b'], Context::createDefaultContext()));
+    }
+
+    public function testSkipsAnEmptyDigest(): void
+    {
+        $logger = $this->createMock(LoggerInterface::class);
+        $logger->expects(static::never())->method('info');
+
+        $subscriber = new LowStockDigestLogSubscriber($logger);
+        $subscriber->onDigestPrinted(new LowStockDigestPrintedEvent([], Context::createDefaultContext()));
+    }
+
+    public function testSubscribesToThePrintedEvent(): void
+    {
+        static::assertArrayHasKey(
+            LowStockDigestPrintedEvent::class,
+            LowStockDigestLogSubscriber::getSubscribedEvents(),
+        );
+    }
+}
