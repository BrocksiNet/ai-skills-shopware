@@ -0,0 +1,16 @@
+{% block swag_loyalty_tier_list %}
+<sw-page class="swag-loyalty-tier-list">
+    <template #content>
+        <sw-entity-listing
+            v-if="tiers"
+            :items="tiers"
+            :columns="columns"
+            :repository="tierRepository"
+            :is-loading="isLoading"
+            :allow-edit="acl.can('swag_loyalty_tier.editor')"
+            :allow-delete="acl.can('swag_loyalty_tier.deleter')"
+            :show-selection="acl.can('swag_loyalty_tier.deleter')"
+        />
+    </template>
+</sw-page>
+{% endblock %}
