--- /dev/null
+++ b/src/Support/MoneyFormatter.php
@@ -0,0 +1,14 @@
+<?php declare(strict_types=1);
+
+namespace Swag\OrderTools\Support;
+
+class MoneyFormatter
+{
+    /**
+     * One place for the German number format the plugin prints.
+     */
+    public static function format(float $amount): string
+    {
+        return number_format($amount, 2, ',', '.');
+    }
+}
