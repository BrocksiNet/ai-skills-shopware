diff --git a/src/Resources/app/administration/src/extension/sw-order-list/index.js b/src/Resources/app/administration/src/extension/sw-order-list/index.js
new file mode 100644
index 0000000..e2744ef
--- /dev/null
+++ b/src/Resources/app/administration/src/extension/sw-order-list/index.js
@@ -0,0 +1,52 @@
+const { Component } = Shopware;
+
+Component.override('sw-order-list', {
+    computed: {
+        orderCriteria() {
+            const criteria = this.$super('orderCriteria');
+            criteria.addAssociation('swagLoyaltyPoints');
+
+            return criteria;
+        },
+    },
+
+    methods: {
+        getOrderColumns() {
+            return [{
+                property: 'orderNumber',
+                label: 'sw-order.list.columnOrderNumber',
+                routerLink: 'sw.order.detail',
+                allowResize: true,
+                primary: true,
+            }, {
+                property: 'salesChannel.name',
+                label: 'sw-order.list.columnSalesChannel',
+                allowResize: true,
+            }, {
+                property: 'orderCustomer.firstName',
+                dataIndex: 'orderCustomer.lastName,orderCustomer.firstName',
+                label: 'sw-order.list.columnCustomerName',
+                allowResize: true,
+            }, {
+                property: 'amountTotal',
+                label: 'sw-order.list.columnAmount',
+                align: 'right',
+                allowResize: true,
+            }, {
+                property: 'stateMachineState.name',
+                label: 'sw-order.list.columnState',
+                allowResize: true,
+            }, {
+                property: 'orderDateTime',
+                label: 'sw-order.list.orderDate',
+                allowResize: true,
+            }, {
+                property: 'extensions.swagLoyaltyPoints.points',
+                label: 'swag-loyalty.orderList.columnPoints',
+                align: 'right',
+                allowResize: true,
+                sortable: false,
+            }];
+        },
+    },
+});
