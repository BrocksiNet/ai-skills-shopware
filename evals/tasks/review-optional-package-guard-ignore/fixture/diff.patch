diff --git a/src/Resources/views/storefront/page/account/loyalty.html.twig b/src/Resources/views/storefront/page/account/loyalty.html.twig
new file mode 100644
index 0000000..4480dd5
--- /dev/null
+++ b/src/Resources/views/storefront/page/account/loyalty.html.twig
@@ -0,0 +1,21 @@
+{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}
+
+{% block page_account_main_content %}
+    <div class="account-loyalty">
+        <h1 class="account-welcome">{{ 'swagLoyalty.account.title'|trans|sw_sanitize }}</h1>
+
+        <p class="account-loyalty-balance">
+            {{ 'swagLoyalty.account.balance'|trans({ '%points%': balance })|sw_sanitize }}
+        </p>
+
+        <table class="table account-loyalty-history">
+            {% for entry in history %}
+                <tr>
+                    <td>{{ entry.date|format_date('short', locale=app.request.locale) }}</td>
+                    <td>{{ entry.reason }}</td>
+                    <td class="text-end">{{ entry.points }}</td>
+                </tr>
+            {% endfor %}
+        </table>
+    </div>
+{% endblock %}
diff --git a/src/Storefront/Controller/LoyaltyPageController.php b/src/Storefront/Controller/LoyaltyPageController.php
