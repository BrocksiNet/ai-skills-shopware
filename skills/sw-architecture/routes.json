{
  "$comment": "Which reference to read for a change (plan WP4). paths_any: globs on changed files; anchors_any: regexes on added or removed lines; always: every change; on_demand: the task decides, the diff cannot. Render the SKILL.md table with node tools/bin/render-routes.ts.",
  "exclude_paths": [
    "**/tests/**",
    "**/Test/**",
    "**/*.md"
  ],
  "routes": [
    {
      "reference": "references/progressive-enhancement.md",
      "when": "A change must roll out without breaking existing callers.",
      "anchors_any": [
        "Feature::isActive\\(",
        "@deprecated tag:v"
      ],
      "exclude_paths": [
        "**/tests/**",
        "**/Test/**",
        "**/*.md",
        "**/Resources/app/**",
        "**/*.{js,ts,scss}"
      ]
    },
    {
      "reference": "references/component-independence.md",
      "when": "A change couples two components or bundles.",
      "anchors_any": [
        "use Shopware\\\\(Storefront|Administration|Elasticsearch)\\\\"
      ],
      "exclude_paths": [
        "**/tests/**",
        "**/Test/**",
        "**/*.md",
        "src/Storefront/**",
        "src/Administration/**",
        "src/Elasticsearch/**"
      ]
    },
    {
      "reference": "references/dal-contracts.md",
      "when": "You touch a DAL definition, entity or repository contract.",
      "paths_any": [
        "**/*Definition.php",
        "**/*EntityExtension.php"
      ],
      "anchors_any": [
        "extends (Entity|EntityTranslation|MappingEntity)Definition",
        "extends EntityExtension",
        "EntityRepository"
      ]
    },
    {
      "reference": "references/symfony-in-shopware.md",
      "when": "You reach for a Symfony component or container feature, or a service keeps state in a property.",
      "anchors_any": [
        "HttpClientInterface",
        "ClockInterface",
        "MessageBusInterface",
        "ResetInterface",
        "kernel\\.reset",
        "\\$this->[A-Za-z]+\\[[^\\]]+\\] \\?\\?="
      ]
    },
    {
      "reference": "references/extension-mechanisms.md",
      "when": "You choose between an event, a decoration and a core edit, or change an event.",
      "paths_any": [
        "**/*Event.php",
        "**/Resources/config/services.{xml,php}"
      ],
      "anchors_any": [
        "decorates",
        "#\\[AsEventListener",
        "getSubscribedEvents\\(",
        "ExtensionDispatcher",
        "extends (Event|Extension|NestedEvent)\\b"
      ]
    },
    {
      "reference": "references/anti-patterns.md",
      "when": "You check a design against known mistakes.",
      "paths_any": [
        "**/vendor/shopware/**"
      ],
      "anchors_any": [
        "Doctrine\\\\DBAL\\\\Connection",
        "Feature::fake\\("
      ],
      "exclude_paths": [
        "**/*.md"
      ]
    },
    {
      "reference": "references/pattern-catalog.md",
      "when": "You need an established pattern or want to propose one.",
      "anchors_any": [
        "[ (!]time\\(\\)",
        "CacheTagsEvent",
        "#\\[CoversNothing\\]"
      ],
      "exclude_paths": [
        "**/*.md"
      ]
    }
  ]
}
