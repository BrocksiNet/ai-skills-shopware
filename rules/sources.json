{
  "$schema": "./sources.schema.json",
  "sources": [
    {
      "id": "shopware",
      "repo": "shopware/shopware",
      "branch": "trunk",
      "extractor": "shopware-trunk",
      "paths": [
        ".agents",
        ".agents-templates/AGENTS.local.template.ddev.md",
        ".agents-templates/AGENTS.local.template.docker.md",
        ".agents-templates/AGENTS.local.template.native.md",
        ".agents-templates/AGENTS.local.template.vagrant.md",
        "coding-guidelines",
        "adr/2026-06-17-shared-guidance-files-for-humans-and-agents.md",
        "src/Core/DevOps/StaticAnalyze",
        ".github/AGENTS.md",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "AGENTS.md",
        "src/Administration/Resources/app/administration/AGENTS.md",
        "src/Administration/Resources/app/administration/src/app/AGENTS.md",
        "src/Administration/Resources/app/administration/src/core/AGENTS.md",
        "src/Administration/Resources/app/administration/src/module/AGENTS.md",
        "src/Administration/Resources/app/administration/.stylelintrc",
        "src/Administration/Resources/app/administration/eslint.config.ts",
        "src/Storefront/Resources/app/administration/eslint.config.ts",
        "src/Storefront/Resources/app/storefront/eslint.config.js",
        "src/Storefront/Resources/app/storefront/stylelint.config.js",
        "src/Storefront/Resources/views/ludtwig-config.toml"
      ],
      "skills": [
        { "path": ".agents/skills/shopware-admin-js", "skills": ["sw-admin-js"] },
        { "path": ".agents/skills/shopware-change-scope", "skills": ["sw-review-learnings"] },
        { "path": ".agents/skills/shopware-knowledge-capture", "skills": ["sw-core-development"] },
        { "path": ".agents/skills/shopware-php-code", "skills": ["sw-architecture"] },
        { "path": ".agents/skills/shopware-phpunit-tests", "skills": ["sw-testing"] },
        { "path": ".agents/skills/shopware-pr-hygiene", "skills": ["sw-pr-description"] },
        { "path": ".agents/skills/shopware-release-docs", "skills": ["sw-core-development"] },
        { "path": ".agents/skills/sw-bugfixer", "skills": ["sw-research-and-escalation", "sw-change-impact"] },
        { "path": ".agents/skills/sw-review", "skills": ["sw-pr-review", "sw-extension-review"] },
        { "path": ".agents-templates", "skills": ["sw-local-dev"] },
        { "path": "adr/2026-06-17-shared-guidance-files-for-humans-and-agents.md", "skills": ["sw-core-development"] },
        { "path": "coding-guidelines/core/agent-skills.md", "skills": ["sw-core-development"] },
        { "path": ".github/AGENTS.md", "skills": ["sw-core-development"] },
        { "path": ".github/PULL_REQUEST_TEMPLATE.md", "skills": ["sw-pr-description"] },
        { "path": "AGENTS.md", "skills": ["sw-admin-js", "sw-core-development", "sw-testing"] },
        { "path": "src/Administration/Resources/app/administration/AGENTS.md", "skills": ["sw-admin-js"] },
        { "path": "src/Administration/Resources/app/administration/src", "skills": ["sw-admin-js"] },
        { "path": "src/Administration/Resources/app/administration/.stylelintrc", "skills": ["sw-admin-js"] },
        { "path": "src/Administration/Resources/app/administration/eslint.config.ts", "skills": ["sw-admin-js"] },
        { "path": "src/Storefront/Resources/app/administration/eslint.config.ts", "skills": ["sw-admin-js"] },
        { "path": "src/Storefront/Resources/app/storefront", "skills": ["sw-storefront"] },
        { "path": "src/Storefront/Resources/views/ludtwig-config.toml", "skills": ["sw-storefront"] }
      ],
      "ignore": [".agents/skills/nightly-triage", ".agents/skills/sw-triage"]
    },
    {
      "id": "shopware-dto-contract",
      "repo": "shopware/shopware",
      "branch": "trunk",
      "extractor": "markdown",
      "paths": ["src/Core/Framework/Api/OpenApi/AGENTS.md", "tests/unit/Core/Framework/Api/OpenApi/AGENTS.md"],
      "skills": [
        { "path": "src/Core/Framework/Api/OpenApi/AGENTS.md", "skills": ["sw-openapi-dto"] },
        { "path": "tests/unit/Core/Framework/Api/OpenApi/AGENTS.md", "skills": ["sw-openapi-dto"] }
      ]
    },
    {
      "id": "ai-coding-tools",
      "repo": "shopwareLabs/ai-coding-tools",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["plugins/test-writing", "plugins/contributor-writing", "plugins/code-migration", "plugins/dev-tooling"],
      "skills": [
        { "path": "plugins/test-writing", "skills": ["sw-testing"] },
        { "path": "plugins/contributor-writing", "skills": ["sw-pr-description"] },
        { "path": "plugins/code-migration", "skills": ["sw-plugin-development"] },
        { "path": "plugins/dev-tooling", "skills": ["sw-local-dev"] }
      ]
    },
    {
      "id": "php-modernization",
      "repo": "netresearch/php-modernization-skill",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["skills"],
      "skills": [{ "path": "skills", "skills": ["sw-php-foundation"] }]
    },
    {
      "id": "shopware-cli",
      "repo": "shopware/shopware-cli",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["skills"],
      "skills": [{ "path": "skills", "skills": ["sw-local-dev"] }]
    },
    {
      "id": "shopware-rector",
      "repo": "FriendsOfShopware/shopware-rector",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["README.md", "docs"],
      "skills": [
        { "path": "README.md", "skills": ["sw-plugin-development"] },
        { "path": "docs", "skills": ["sw-plugin-development"] }
      ]
    },
    {
      "id": "fos-agent-skills",
      "repo": "FriendsOfShopware/agent-skills",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["skills"],
      "skills": [
        { "path": "skills/shopware-phpunit", "skills": ["sw-testing"] },
        { "path": "skills/shopware-admin-crud-module", "skills": ["sw-admin-js"] },
        { "path": "skills/shopware-extension-security", "skills": ["sw-security", "sw-extension-review"] },
        { "path": "skills/shopware-store-preflight", "skills": ["sw-extension-review"] }
      ]
    },
    {
      "id": "humanizer",
      "repo": "blader/humanizer",
      "branch": "main",
      "extractor": "markdown",
      "paths": ["SKILL.md"],
      "skills": [{ "path": "SKILL.md", "skills": ["sw-assistant-style"] }]
    }
  ],
  "reviews": [
    { "id": "core-reviews", "repo": "shopware/shopware", "base": "trunk", "private": false },
    { "id": "commercial-reviews", "repo": "shopware/SwagCommercial", "base": "trunk", "private": true }
  ]
}
