+++ b/src/Resources/app/administration/src/service/swag-loyalty-settings.api.service.js
@@ -0,0 +1,20 @@
+const { ApiService } = Shopware.Classes;
+
+export default class SwagLoyaltySettingsApiService extends ApiService {
+    constructor(httpClient, loginService, apiEndpoint = 'swag-loyalty') {
+        super(httpClient, loginService, apiEndpoint);
+        this.name = 'swagLoyaltySettingsService';
+    }
+
+    getSettings() {
+        return this.httpClient
+            .get(`_action/${this.getApiBasePath()}/settings`, { headers: this.getBasicHeaders() })
+            .then((response) => ApiService.handleResponse(response));
+    }
+
+    saveSettings(settings) {
+        return this.httpClient
+            .post(`_action/${this.getApiBasePath()}/settings`, settings, { headers: this.getBasicHeaders() })
+            .then((response) => ApiService.handleResponse(response));
+    }
+}
