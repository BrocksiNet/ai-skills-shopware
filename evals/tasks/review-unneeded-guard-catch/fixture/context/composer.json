{
    "name": "swag/media-cdn",
    "description": "Serve media through a CDN",
    "type": "shopware-platform-plugin",
    "version": "1.4.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.6.0 || ~6.7.0"
    },
    "autoload": {
        "psr-4": {
            "Swag\\MediaCdn\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Swag\\MediaCdn\\SwagMediaCdn",
