+<?php declare(strict_types=1);
+
+namespace Swag\Catalog\Mcp\Tool;
+
+use Mcp\Capability\Attribute\McpTool;
+use Mcp\Capability\Attribute\Schema;
+use Mcp\Schema\ToolAnnotations;
+use Shopware\Core\Framework\Api\Acl\AclCriteriaValidator;
+use Shopware\Core\Framework\Api\Serializer\JsonEntityEncoder;
+use Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\RequestCriteriaBuilder;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolGroup;
+use Shopware\Core\Framework\Mcp\Attribute\McpToolRequires;
+use Shopware\Core\Framework\Mcp\Context\McpContextProvider;
+use Shopware\Core\Framework\Mcp\Result\McpToolResult;
+use Shopware\Core\Framework\Mcp\Tool\McpEntityIncludes;
+use Shopware\Core\Framework\Mcp\Tool\McpToolResponse;
+use Shopware\Core\Framework\ShopwareHttpException;
+
+#[McpTool(
+    name: 'swag-catalog-product-search',
+    title: 'Catalog Product Search',
+    annotations: new ToolAnnotations(readOnlyHint: true, openWorldHint: false),
+    description: 'Search catalog products using criteria JSON.',
+)]
+#[McpToolGroup('swag-catalog', description: 'Search and inspect catalog products.')]
+#[McpToolRequires('product:read')]
+class ProductCriteriaTool extends McpToolResponse
+{
+    use McpEntityIncludes;
+
+    public function __construct(
+        private readonly DefinitionInstanceRegistry $registry,
+        private readonly RequestCriteriaBuilder $criteriaBuilder,
+        private readonly AclCriteriaValidator $aclCriteriaValidator,
+        private readonly JsonEntityEncoder $encoder,
+        private readonly McpContextProvider $contextProvider,
+    ) {
+    }
+
+    public function __invoke(
+        #[Schema(description: 'Admin API criteria JSON object.')]
+        string $criteria = '{}',
+        #[Schema(description: 'Maximum rows to return (1-100).')]
+        int $limit = 25,
+    ): McpToolResult {
+        $context = $this->contextProvider->getContext();
+        $privilegeError = $this->requirePrivilegeResult($context, 'product:read');
+        if ($privilegeError !== null) {
+            return $privilegeError;
+        }
+
+        $decoded = $this->decodeJsonOrErrorResult($criteria, 'criteria');
+        if ($decoded instanceof McpToolResult) {
+            return $decoded;
+        }
+        $requestedLimit = isset($decoded['limit']) && \is_int($decoded['limit']) ? $decoded['limit'] : $limit;
+        $decoded['limit'] = max(1, min($requestedLimit, 100));
+
+        $definition = $this->registry->getByEntityName('product');
+        try {
+            $criteriaObj = $this->criteriaBuilder->fromArray($decoded, new Criteria(), $definition, $context);
+        } catch (ShopwareHttpException $e) {
+            return $this->invalidCriteriaResult($e);
+        }
+
+        $missing = $this->aclCriteriaValidator->validate('product', $criteriaObj, $context);
+        if ($missing !== []) {
+            return $this->missingPrivilegesResult($missing);
+        }
+
+        $this->applyDefaultIncludes($definition, $criteriaObj);
+        $result = $this->registry->getRepository('product')->search($criteriaObj, $context);
+        $rows = $this->encoder->encode($criteriaObj, $definition, $result->getEntities(), '/api');
+
+        return $this->successResult($rows, ['total' => $result->getTotal()]);
+    }
+}
