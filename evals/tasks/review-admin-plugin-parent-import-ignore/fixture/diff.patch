@@ -0,0 +1,30 @@
+import template from './swag-loyalty-order-summary.html.twig';
+
+export default Shopware.Component.wrapComponentConfig({
+    template,
+
+    emits: ['reload'],
+
+    props: {
+        balance: {
+            type: Number,
+            required: true,
+        },
+        currencyIsoCode: {
+            type: String,
+            required: true,
+        },
+    },
+
+    computed: {
+        formattedBalance(): string {
+            return Shopware.Utils.format.currency(this.balance, this.currencyIsoCode);
+        },
+    },
+
+    methods: {
+        onRefresh(): void {
+            this.$emit('reload');
+        },
+    },
+});
