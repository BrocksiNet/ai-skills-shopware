+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Tests\Unit\Service;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Content\Product\ProductCollection;
+use Shopware\Core\Content\Product\ProductDefinition;
+use Shopware\Core\Content\Product\ProductEntity;
+use Shopware\Core\Framework\Context;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\Criteria;
+use Shopware\Core\Framework\DataAbstractionLayer\Search\EntitySearchResult;
+use Shopware\Core\System\SystemConfig\SystemConfigService;
+use Swag\LowStockDigest\Service\LowStockDigestBuilder;
+
+#[CoversClass(LowStockDigestBuilder::class)]
+class LowStockDigestBuilderTest extends TestCase
+{
+    public function testThresholdFallsBackToTheDefaultWhenUnset(): void
+    {
+        $config = $this->createMock(SystemConfigService::class);
+        $config->method('getInt')->willReturn(0);
+
+        $builder = new LowStockDigestBuilder($this->createMock(EntityRepository::class), $config);
+
+        static::assertSame(LowStockDigestBuilder::DEFAULT_THRESHOLD, $builder->threshold());
+    }
+
+    public function testThresholdReadsTheValueForTheSalesChannel(): void
+    {
+        $config = $this->createMock(SystemConfigService::class);
+        $config->expects(static::once())
+            ->method('getInt')
+            ->with(LowStockDigestBuilder::CONFIG_THRESHOLD, 'sales-channel-1')
+            ->willReturn(12);
+
+        $builder = new LowStockDigestBuilder($this->createMock(EntityRepository::class), $config);
+
+        static::assertSame(12, $builder->threshold('sales-channel-1'));
+    }
+
+    public function testBuildMapsTheLowStockProducts(): void
+    {
+        $product = new ProductEntity();
+        $product->setId('0f1c6a1e2b3d4c5f8a9b0c1d2e3f4a5b');
+        $product->setProductNumber('SW-100');
+        $product->setStock(2);
+
+        $result = new EntitySearchResult(
+            ProductDefinition::ENTITY_NAME,
+            1,
+            new ProductCollection([$product]),
+            null,
+            new Criteria(),
+            Context::createDefaultContext(),
+        );
+
+        $repository = $this->createMock(EntityRepository::class);
+        $repository->method('search')->willReturn($result);
+
+        $config = $this->createMock(SystemConfigService::class);
+        $config->method('getInt')->willReturn(5);
+
+        $rows = (new LowStockDigestBuilder($repository, $config))->build(Context::createDefaultContext());
+
+        static::assertSame([[
+            'id' => '0f1c6a1e2b3d4c5f8a9b0c1d2e3f4a5b',
+            'productNumber' => 'SW-100',
+            'name' => null,
+            'stock' => 2,
+        ]], $rows);
+    }
+}
