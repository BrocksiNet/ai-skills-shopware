@@ -0,0 +1,27 @@
+<?php declare(strict_types=1);
+
+namespace Swag\Loyalty\Subscriber;
+
+use Shopware\Core\Content\Product\Events\ProductDetailRouteCacheTagsEvent;
+use Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRouteResponse;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+class LoyaltyBadgeCacheTagSubscriber implements EventSubscriberInterface
+{
+    public static function getSubscribedEvents(): array
+    {
+        return [
+            ProductDetailRouteCacheTagsEvent::class => 'onProductDetailCacheTags',
+        ];
+    }
+
+    public function onProductDetailCacheTags(ProductDetailRouteCacheTagsEvent $event): void
+    {
+        $response = $event->getResponse();
+        if (!$response instanceof ProductDetailRouteResponse) {
+            return;
+        }
+
+        $event->addTags(['swag-loyalty-badge-' . $response->getProduct()->getId()]);
+    }
+}
