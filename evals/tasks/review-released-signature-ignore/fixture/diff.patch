+
+/**
+ * Summary of the approved reviews of one product. New in this change, not released yet.
+ */
+#[Route(path: '/store-api/product/{productId}/review-summary', name: 'store-api.product-review.summary', methods: ['POST'])]
+class ReviewSummaryRoute
