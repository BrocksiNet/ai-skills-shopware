+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Tests\Unit\Command;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Swag\LowStockDigest\Command\LowStockDigestCommand;
+use Swag\LowStockDigest\Service\LowStockDigestBuilder;
+use Swag\LowStockDigest\Service\LowStockDigestFormatter;
+use Symfony\Component\Console\Tester\CommandTester;
+use Symfony\Component\EventDispatcher\EventDispatcher;
+
+#[CoversClass(LowStockDigestCommand::class)]
+class LowStockDigestCommandTest extends TestCase
+{
+    public function testSaysSoWhenNothingIsLow(): void
+    {
+        $builder = $this->createMock(LowStockDigestBuilder::class);
+        $builder->method('build')->willReturn([]);
+
+        $tester = $this->tester($builder);
+        $tester->execute([]);
+
+        static::assertSame(0, $tester->getStatusCode());
+        static::assertStringContainsString('No product is at or below the threshold.', $tester->getDisplay());
+    }
+
+    public function testPrintsJsonWhenAsked(): void
+    {
+        $builder = $this->createMock(LowStockDigestBuilder::class);
+        $builder->method('build')->willReturn([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug', 'stock' => 1],
+        ]);
+
+        $tester = $this->tester($builder);
+        $tester->execute(['--json' => true]);
+
+        static::assertStringContainsString('"productNumber": "SW-1"', $tester->getDisplay());
+    }
+
+    public function testPrintsCsvWhenAsked(): void
+    {
+        $builder = $this->createMock(LowStockDigestBuilder::class);
+        $builder->method('build')->willReturn([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug', 'stock' => 1],
+        ]);
+
+        $tester = $this->tester($builder);
+        $tester->execute(['--csv' => true]);
+
+        static::assertStringContainsString("SW-1;Mug;1\n", $tester->getDisplay());
+    }
+
+    public function testWarnsWithTheCountWhenProductsAreLow(): void
+    {
+        $builder = $this->createMock(LowStockDigestBuilder::class);
+        $builder->method('build')->willReturn([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug', 'stock' => 1],
+            ['id' => 'b', 'productNumber' => 'SW-2', 'name' => null, 'stock' => 0],
+        ]);
+
+        $tester = $this->tester($builder);
+        $tester->execute([]);
+
+        static::assertStringContainsString('2 product(s) need a restock.', $tester->getDisplay());
+    }
+
+    private function tester(LowStockDigestBuilder $builder): CommandTester
+    {
+        return new CommandTester(new LowStockDigestCommand($builder, new LowStockDigestFormatter(), new EventDispatcher()));
+    }
+}
