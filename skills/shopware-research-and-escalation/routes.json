{
  "$comment": "Which reference to read for a change (plan WP4). paths_any: globs on changed files; anchors_any: regexes on added or removed lines. Render the SKILL.md table with node tools/bin/render-routes.ts.",
  "routes": [
    {
      "reference": "references/docs-map.md",
      "when": "You need to know where Shopware documents a topic.",
      "anchors_any": ["developer\\.shopware\\.com/docs"]
    },
    {
      "reference": "references/context7-and-libraries.md",
      "when": "You check library docs or verify against source.",
      "paths_any": ["**/composer.json", "**/composer.lock", "**/package.json", "**/package-lock.json"]
    },
    {
      "reference": "references/modern-web-guidance.md",
      "when": "The question is about a generic CSS, HTML or JS API.",
      "anchors_any": [
        "speculationrules",
        "startViewTransition\\(|@view-transition",
        "<dialog[ >]",
        "\\bpopover=",
        "container-type:|@container\\b"
      ]
    },
    {
      "reference": "references/when-stuck.md",
      "when": "An approach keeps failing.",
      "paths_any": ["**/phpstan-baseline.neon"],
      "anchors_any": [
        "@phpstan-ignore",
        "@ts-(ignore|expect-error)",
        "markTestSkipped\\(",
        "catch \\([^)]*\\) \\{ *\\}"
      ]
    }
  ]
}
