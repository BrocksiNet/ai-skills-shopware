+<?php declare(strict_types=1);
+
+namespace Swag\LowStockDigest\Tests\Unit\Service;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Swag\LowStockDigest\Service\LowStockDigestFormatter;
+
+#[CoversClass(LowStockDigestFormatter::class)]
+class LowStockDigestFormatterTest extends TestCase
+{
+    public function testCsvHasAHeaderAndOneLinePerProduct(): void
+    {
+        $csv = (new LowStockDigestFormatter())->toCsv([
+            ['id' => 'a', 'productNumber' => 'SW-1', 'name' => 'Mug', 'stock' => 1],
+            ['id' => 'b', 'productNumber' => 'SW-2', 'name' => null, 'stock' => 0],
