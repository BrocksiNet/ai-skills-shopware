            "**/*Event.php",
            "**/Resources/config/services.{xml,php}"
          ],
          "anchors_any": [
            "decorates",
            "#\\[AsEventListener",
            "getSubscribedEvents\\(",
            "ExtensionDispatcher",
            "extends (Event|Extension|NestedEvent)\\b"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-architecture/references/dal-contracts.md",
          "when": "You touch a DAL definition, entity or repository contract.",
          "paths_any": [
            "**/*Definition.php",
            "**/*EntityExtension.php"
          ],
          "anchors_any": [
            "extends (Entity|EntityTranslation|MappingEntity)Definition",
            "extends EntityExtension",
            "EntityRepository"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-review-learnings/references/api-aware.md",
          "when": "The code serves Store-API or headless clients.",
          "paths_any": [
            "**/StoreApi/**/*.php",
            "**/SalesChannel/**/*Route.php"
          ],
          "anchors_any": [
            "store-api",
            "StoreApiResponse",
            "extends Abstract[A-Za-z]+Route\\b"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-review-learnings/references/dal-and-performance.md",
          "when": "The code queries the DAL, checks what a customer can see, runs on a hot path, or dispatches queued work.",
          "anchors_any": [
            "new Criteria\\(",
            "MessageBusInterface",
            "->dispatch\\(new [A-Za-z]+Message\\(",
            "->addAssociation\\(",
            "EqualsFilter\\(",
            "->fetch(All|One|Associative|FirstColumn)[A-Za-z]*\\(",
            "->searchIds\\("
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-review-learnings/references/version-guards.md",
          "when": "The change adds or keeps a class_exists or method_exists check for Shopware API.",
          "anchors_any": [
            "(class|method|interface)_exists\\((\\\\?Shopware\\b|[A-Z][A-Za-z]+::class)"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-review-learnings/references/code-comments.md",
          "when": "The change adds or edits comments or docblocks that talk about earlier versions, removed code or the issue.",
          "anchors_any": [
            "^\\s*(//|#|\\*|/\\*).*\\b([Pp]reviously|[Oo]riginally|used to|no longer|[Ee]arlier (version|revision|approach)|[Bb]efore this (change|PR|fix)|this (PR|pull request)|was (changed|replaced|removed) (to|in|with)|instead of the old)\\b",
            "^\\s*(//|#|\\*|/\\*).*\\(see #\\d+\\)"
          ],
          "exclude_paths": [
            "**/tests/**",
            "**/Test/**",
            "**/*.md"
          ]
        },
        {
          "reference": "sw-testing/references/test-shape-and-flags.md",
          "when": "You need data providers, feature flags or coverage attributes, or a change edits an assertion.",
          "anchors_any": [
            "#\\[DataProvider\\(",
            "(::|->)(assert[A-Z]\\w*|markTest(Skipped|Incomplete))\\(",
            "^\\s*yield\\s+(['\"]).*\\1\\s*=>",
            "Feature::(fake|skipTestIf(In)?Active)\\(",
            "#\\[Covers(Class|Function|Nothing)[(\\]]",
            "new \\\\?Reflection(Class|Property|Method)\\(",
            "StaticEntityRepository"
          ]
        },
        {
          "reference": "sw-testing/references/integration-repository.md",
          "when": "An integration test reads or writes through a repository.",
          "paths_any": [
            "**/tests/integration/**/*Test.php"
          ],
          "anchors_any": [
