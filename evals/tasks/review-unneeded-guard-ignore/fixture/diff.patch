+<?php declare(strict_types=1);
+
+namespace Swag\MediaCdn\Service;
+
+use Shopware\Core\Content\Media\Upload\MediaUploadService;
+use Shopware\Core\Framework\Context;
+
+class RemoteMediaImporter
+{
+    public function __construct(
+        private readonly MediaUploadService $uploadService,
+        private readonly CdnClient $cdnClient,
+    ) {
+    }
+
+    public function import(string $url, Context $context): string
+    {
+        $mediaId = $this->uploadService->uploadFromURL($url, $context);
+        $this->cdnClient->purgeMedia([$mediaId]);
+
+        return $mediaId;
+    }
+}
